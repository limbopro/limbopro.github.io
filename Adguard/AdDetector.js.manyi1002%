    makeDraggable() {
      const panel = this.shadow.querySelector('#main-panel');
      const header = this.shadow.querySelector('#panel-header');
      const edges = this.shadow.querySelectorAll('.edge-drag');

      let isDragging = false;
      let startX = 0;
      let startY = 0;

      let currentTranslateX = 0;
      let currentTranslateY = 0;
      let startTranslateX = 0;
      let startTranslateY = 0;

      try {
        let savedPos = null;
        if (typeof GM_getValue !== 'undefined') {
          savedPos = GM_getValue('ad_detector_panel_transform', null);
        } else if (window.localStorage) {
          savedPos = JSON.parse(localStorage.getItem('ad_detector_panel_transform') || 'null');
        }
        if (savedPos && savedPos.x !== undefined && savedPos.y !== undefined) {
          currentTranslateX = savedPos.x;
          currentTranslateY = savedPos.y;
          panel.style.transform = `translate3d(${currentTranslateX}px, ${currentTranslateY}px, 0)`;
        }
      } catch (e) { }

      const startDrag = (e) => {
        if (e.target.closest('#btn-close-panel') || e.target.closest('.select-control')) return;
        if (e.button !== undefined && e.button !== 0) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        startTranslateX = currentTranslateX;
        startTranslateY = currentTranslateY;

        document.body.style.userSelect = 'none';
        e.preventDefault();
      };

      const moveDrag = (e) => {
        if (!isDragging) return;

        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;

        currentTranslateX = startTranslateX + deltaX;
        currentTranslateY = startTranslateY + deltaY;

        panel.style.transform = `translate3d(${currentTranslateX}px, ${currentTranslateY}px, 0)`;
      };

      const stopDrag = () => {
        if (!isDragging) return;
        isDragging = false;

        document.body.style.userSelect = '';

        const posData = { x: currentTranslateX, y: currentTranslateY };
        try {
          if (typeof GM_setValue !== 'undefined') {
            GM_setValue('ad_detector_panel_transform', posData);
          } else if (window.localStorage) {
            localStorage.setItem('ad_detector_panel_transform', JSON.stringify(posData));
          }
        } catch (err) {
          console.warn('[AdDetector] 无法保存面板位置', err);
        }
      };

      const dragTargets = [header, ...edges];
      dragTargets.forEach((el) => {
        if (!el) return;
        el.addEventListener('pointerdown', startDrag);
      });

      window.addEventListener('pointermove', moveDrag);
      window.addEventListener('pointerup', stopDrag);
      window.addEventListener('pointercancel', stopDrag);
    }

    applyHighlight(el, enable, sizeText = '') {
      if (!el || el.dataset.overlayBlocked === 'true') {
        el.classList.remove('ad-detector-highlight-active', 'ad-detector-pos-relative');
        return;
      }

      if (enable) {
        if (window.getComputedStyle(el).position === 'static') {
          el.classList.add('ad-detector-pos-relative');
        }

        let badge = el.querySelector(':scope > .ad-detector-size-badge');
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'ad-detector-size-badge';
          el.appendChild(badge);
