          </div>
        `;
        previewBody.appendChild(codeSection);
      }

      const codeBlock = this.shadow.querySelector('#preview-code-block');
      const copyBtn = this.shadow.querySelector('#btn-copy-code');

      codeBlock.textContent = rawHtml;

      copyBtn.onclick = () => {
        navigator.clipboard.writeText(codeBlock.textContent).then(() => {
          copyBtn.textContent = '已复制！';
          setTimeout(() => { copyBtn.textContent = '复制源码'; }, 1500);
        }).catch(err => {
          console.error('复制代码失败:', err);
        });
      };

      const renderPreviewActions = () => {
        if (!meta.isBlocked) {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-hide-single" id="btn-preview-hide">🚫 单独屏蔽</button>
          `;
          const btnHide = actionsContainer.querySelector('#btn-preview-hide');
          btnHide.onclick = () => {
            this.neutralizeSingle(adId);
            renderPreviewActions();
            setTimeout(() => {
              modal.style.display = 'none';
              container.innerHTML = '';
            }, 1200);
          };
        } else {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-restore-single" id="btn-preview-restore">↩️ 撤销屏蔽</button>
          `;
          const btnRestore = actionsContainer.querySelector('#btn-preview-restore');
          btnRestore.onclick = () => {
            this.restoreSingle(adId);
            renderPreviewActions();
          };
        }
      };

      renderPreviewActions();

      modal.style.display = 'flex';

      const closeBtn = this.shadow.querySelector('#btn-close-preview');
      closeBtn.onclick = () => {
        modal.style.display = 'none';
        container.innerHTML = '';
        this.updateUI();
      };
    }

    previewHoverElement(adId, isHovering) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element || meta.isBlocked) return;

      if (this.observer) {
        this.observer.disconnect();
      }

      if (isHovering) {
        meta.element.classList.add('ad-detector-hover-active');

        // 使元素平滑滚动至视野中央
        try {
          meta.element.scrollIntoView({
            behavior: 'smooth', // 平滑动画
            block: 'center',    // 垂直方向居中
            inline: 'center'    // 水平方向居中
          });
        } catch (e) {
          // 兼容旧版浏览器的降级处理
          meta.element.scrollIntoView(false);
        }
      } else {
        meta.element.classList.remove('ad-detector-hover-active');

        const activeChildren = meta.element.querySelectorAll('.ad-detector-hover-active');
        activeChildren.forEach(child => child.classList.remove('ad-detector-hover-active'));

        if (this.isHighlighted) {
          // this.applyHighlight(meta.element, true, meta.size);
          this.applyHighlight(meta.element, true);
        }
      }

      if (this.observer && document.body) {
        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['style', 'class', 'src']
        });
      }
    }

    showToast(message) {
      // 1. 获取或创建紧凑容器
      let container = document.getElementById('global-toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'global-toast-container';
        Object.assign(container.style, {
          position: 'fixed',
          top: '2px',
          left: '50%',
          transform: 'translateX(-50%)',
          zIndex: '2147483647',
          display: 'flex',
          flexDirection: 'column-reverse',
          alignItems: 'center',
          gap: '2px',
          pointerEvents: 'none',
          perspective: '1000px'
        });
        document.body.appendChild(container);
      }

      // 超过 4 条时移除最旧的一条
      if (container.children.length >= 4) {
        const oldestToast = container.firstElementChild;
        if (oldestToast) oldestToast.remove();
      }

      // 2. 遍历所有旧消息：尺寸与字体双重递减
      const existingToasts = Array.from(container.children);
      const totalExisting = existingToasts.length;

      existingToasts.forEach((oldToast, index) => {
        const distanceFromLatest = totalExisting - index;
        const newScale = Math.max(0.7, 1 - distanceFromLatest * 0.08);

        Object.assign(oldToast.style, {
          padding: '5px 12px',
          background: 'rgba(12, 12, 15, 0.85)',
          border: '1px solid rgba(255, 255, 255, 0.05)',
          boxShadow: '0 2px 8px rgba(0, 0, 0, 0.5)',
          fontSize: '11px', // 旧消息字体缩小，突显主次
          fontWeight: '400',
          transform: `scale(${newScale})`,
          transition: 'all 0.25s cubic-bezier(0.16, 1, 0.3, 1)',
          opacity: '1'
        });

        const badge = oldToast.querySelector('.toast-new-badge');
        if (badge) badge.remove();
      });

      // 3. 创建最新的 Toast 节点
      const toast = document.createElement('div');

      toast.innerHTML = `<span class="toast-new-badge" style="
    background: #0066FF;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 6px;
    margin-right: 6px;
    display: inline-block;
    vertical-align: middle;
    letter-spacing: 0.5px;
  ">NEW</span><span style="vertical-align: middle;">${message}</span>`;

      // 最新消息的暗黑高亮与大字号样式
      Object.assign(toast.style, {
        padding: '8px 18px',
        background: 'rgba(18, 18, 22, 0.95)',
        backdropFilter: 'blur(16px)',
        webkitBackdropFilter: 'blur(16px)',
        color: '#ECECF1',
        fontSize: '13.5px', // 字体加粗加大
        lineHeight: '1.4',
        fontWeight: '600',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        borderRadius: '14px',
        border: '1px solid rgba(0, 102, 255, 0.4)',
        boxShadow: '0 4px 16px rgba(0, 0, 0, 0.6), 0 0 10px rgba(0, 102, 255, 0.25)',

        /* 盒模型限制与换行逻辑 */
        boxSizing: 'border-box',
        maxWidth: 'min(85vw, 380px)',
        width: 'max-content',
        whiteSpace: 'normal',
        wordBreak: 'break-word',
        textAlign: 'center',

        opacity: '0',
        transform: 'translateY(-12px) scale(0.92)',
        transition: 'all 0.25s cubic-bezier(0.16, 1, 0.3, 1)',
        pointerEvents: 'auto',
        cursor: 'default',
        userSelect: 'none'
      });

      // 4. 挂载并触发动画
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0) scale(1)';
      });

      // 5. 自动清理
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px) scale(0.9)';

        setTimeout(() => {
          toast.remove();
          if (container.children.length === 0) {
            container.remove();
          }
        }, 250);
      }, 3200);
    }


    bindInteractiveEvents() {
      const btnScan = this.shadow.querySelector('#btn-scan');
      const btnHl = this.shadow.querySelector('#btn-hl');
      const btnClean = this.shadow.querySelector('#btn-clean');
      const btnReset = this.shadow.querySelector('#btn-reset');
      const btnUndo = this.shadow.querySelector('#btn-undo');
      const btnRedo = this.shadow.querySelector('#btn-redo');
      const btnClose = this.shadow.querySelector('#btn-close-panel');
      const selectSort = this.shadow.querySelector('#select-sort');
      const selectFilter = this.shadow.querySelector('#select-filter');

      btnClose.onclick = () => this.hideUI();

      if (selectSort) {
        selectSort.value = this.sortType;
        selectSort.onchange = (e) => {
          this.sortType = e.target.value;
          this.updateUI();
        };
      }

      if (selectFilter) {
        selectFilter.value = this.filterType;
        selectFilter.onchange = (e) => {
          this.filterType = e.target.value;
          this.updateUI();
        };
      }

      btnScan.onclick = () => {
        btnScan.disabled = true;
        btnScan.textContent = '扫描中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            this.scan();
            btnScan.disabled = false;
            btnScan.textContent = '重新扫描';
            this.showToast('✅ 页面诊断完成');
            this.showToast('🔔 若扫描结果不及预期，请刷新页面重试');
          }, 50);
        });
      };

      btnHl.onclick = () => {
        this.toggleHighlight();
        if (this.isHighlighted) {
          btnHl.classList.add('active');
          this.showToast('🔴 已高亮标注高风险元素，请滑动页面查看👀');
        } else {
          btnHl.classList.remove('active');
          this.showToast('⚪ 已还原元素标注');
        }
      };

      btnClean.onclick = () => {
        btnClean.disabled = true;
        btnClean.textContent = '屏蔽中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            const count = this.cleanAll();
            btnClean.disabled = false;
            btnClean.textContent = '一键屏蔽';
            this.showToast(`🛡 已成功屏蔽 ${count} 个威胁`);
          }, 50);
        });
      };

      btnReset.onclick = () => {
        btnReset.disabled = true;
        btnReset.textContent = '重置中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            const count = this.resetAll(); // 1. 清除规则并还原被屏蔽元素
            btnReset.disabled = false;
            btnReset.textContent = '一键重置';
            this.showToast(`🔄 已重置规则并还原 ${count} 个元素`);
          }, 50);
        });
      };

      btnUndo.onclick = () => this.undo();
      btnRedo.onclick = () => this.redo();
    }

    updateUI() {
      if (!this.shadow) return;
      const listEl = this.shadow.querySelector('#list');
      const badge = this.shadow.querySelector('#count-badge');
      const btnUndo = this.shadow.querySelector('#btn-undo');
      const btnRedo = this.shadow.querySelector('#btn-redo');

      if (btnUndo) btnUndo.disabled = this.undoStack.length === 0;
      if (btnRedo) btnRedo.disabled = this.redoStack.length === 0;

      let allDetected = Array.from(this.detectedAds.values());
      const activeUnreadThreats = allDetected.filter((meta) => !meta.isBlocked);

      badge.textContent = `${activeUnreadThreats.length} 未处理 / 共 ${allDetected.length} 个`;

      if (allDetected.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:#30d158;padding:20px;">未发现高风险劫持或广告元素</div>';
        return;
      }

      if (this.filterType === 'unread') {
        allDetected = allDetected.filter((meta) => !meta.isBlocked);
      } else if (this.filterType === 'blocked') {
        allDetected = allDetected.filter((meta) => meta.isBlocked);
      }

      if (allDetected.length === 0) {
        const filterTextMap = { unread: '未处理', blocked: '已屏蔽' };
        listEl.innerHTML = `<div style="text-align:center;color:#8e8e93;padding:20px;">没有符合 [${filterTextMap[this.filterType] || '当前'}] 筛选条件的项</div>`;
        return;
      }

      allDetected.sort((a, b) => {
        if (this.sortType === 'height') {
          return this.getElementHeight(b) - this.getElementHeight(a);
        }
        // 默认排序（按风险分数降序）
        return b.score - a.score;
      });

      let html = '';
      allDetected.forEach((meta) => {
        const isBlocked = meta.isBlocked;
        const isDowngraded = meta.isDowngraded || false;

        // 状态标签生成逻辑（区分常规屏蔽与降级防误伤屏蔽）
        let statusHtml = `<span class="score">${meta.score}分</span>`;
        if (isBlocked) {
          if (isDowngraded) {
            statusHtml = `<div><span class="status-tag" style="background:rgba(255,149,0,0.25);color:#ff9500;">⚠️ 降级防误伤</span> <span class="score">${meta.score}分</span></div>`;
          } else {
            statusHtml = `<div><span class="status-tag">已屏蔽</span> <span class="score">${meta.score}分</span></div>`;
          }
        }

        // 预警说明信息
        const downgradeWarnHtml = isBlocked && isDowngraded && meta.downgradeReason
          ? `<div style="font-size:11px;color:#ff9500;margin-top:4px;line-height:1.3;background:rgba(255,149,0,0.1);padding:4px 6px;border-radius:4px;">
           ⚠️ <strong>误伤预警：</strong>${meta.downgradeReason}
         </div>`
          : '';

        html += `
      <div class="item ${isBlocked ? 'is-blocked' : ''}" data-ad-id="${meta.id}">
        <div class="item-top">
          <div class="item-title">
            <strong>${meta.tagName}</strong>
            <span style="color:#8e8e93;"> 宽高:${meta.size}</span>
          </div>
          ${statusHtml}
        </div>
        <div style="font-size:11px;color:#0a84ff;word-break:break-all;margin-top:2px;">${meta.classAndId || '无 Class/ID'}</div>
        <div class="reasons">原因: ${meta.reasons.join(' | ')}</div>
        ${downgradeWarnHtml}
        <div class="actions">
          ${!isBlocked
            ? `<button class="btn-action btn-preview" data-action="preview" data-id="${meta.id}">🔍 预览元素</button>
               <button class="btn-action btn-hide-single" data-action="hide" data-id="${meta.id}">🚫 单独屏蔽</button>`
            : `<button class="btn-action btn-preview" data-action="preview" data-id="${meta.id}">🔍 预览元素</button>
            <button class="btn-action btn-restore-single" data-action="restore" data-id="${meta.id}">↩️ 撤销屏蔽</button>`
          }
        </div>
      </div>
    `;
      });
      listEl.innerHTML = html;

      listEl.querySelectorAll('.item').forEach((item) => {
        const adId = item.getAttribute('data-ad-id');
        const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

        if (!isTouchDevice) {
          item.addEventListener('pointerenter', (e) => {
            e.stopPropagation();
            this.previewHoverElement(adId, true);
          });

          item.addEventListener('pointerleave', (e) => {
            e.stopPropagation();
            this.previewHoverElement(adId, false);
          });
        } else {
          item.addEventListener('click', (e) => {
            if (e.target.closest('.btn-action')) return;

            e.stopPropagation();

            const currentActiveId = this.activeTouchAdId;

            if (currentActiveId === adId) {
              this.previewHoverElement(adId, false);
              this.activeTouchAdId = null;
            } else {
              if (currentActiveId) {
                this.previewHoverElement(currentActiveId, false);
              }
              this.previewHoverElement(adId, true);
              this.activeTouchAdId = adId;
            }
          });
        }

        item.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-action');
          if (!btn) return;

          const action = btn.getAttribute('data-action');
          const id = btn.getAttribute('data-id');

          if (action === 'preview') {
            this.showPreviewWindow(id);
          } else if (action === 'hide') {
            this.neutralizeSingle(id);
          } else if (action === 'restore') {
            this.restoreSingle(id);
          }
        });
      });

      if (!this.hasTouchGlobalListener) {
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ad-detector-container') && this.activeTouchAdId) {
            this.previewHoverElement(this.activeTouchAdId, false);
            this.activeTouchAdId = null;
          }
        });
        this.hasTouchGlobalListener = true;
      }
    }

  }

  // 单例挂载
  let instance = null;
  function getDetector() {
    if (!instance) {
      instance = new UniversalAdDetector();
    }
    return instance;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => getDetector());
  } else {
    getDetector();
  }

  // 绑定至全局 window 对象
  globalWin.toggleAdDetectorUI = function () {
    getDetector().toggleUI();
  };

  globalWin.showAdDetectorUI = function () {
    getDetector().showUI();
  };

  globalWin.hideAdDetectorUI = function () {
    getDetector().hideUI();
  };

  globalWin.cleanAdsSilently = function () {
    return getDetector().cleanAll();
  };

})();