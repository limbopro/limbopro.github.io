      const targetParent = document.body || document.documentElement;
      targetParent.appendChild(this.host);
      this.bindInteractiveEvents();
      this.makeDraggable();
    }

    makeDraggable() {
      const panel = this.shadow.querySelector('#main-panel');
      const header = this.shadow.querySelector('#panel-header');
      const edges = this.shadow.querySelectorAll('.edge-drag');

      let isDragging = false;
      let startX = 0;
      let startY = 0;

      let currentTranslateX = 0;
      let currentTranslateY = 0;
      let startTranslateX = 0;
      let startTranslateY = 0;

      try {
        let savedPos = null;
        if (typeof GM_getValue !== 'undefined') {
          savedPos = GM_getValue('ad_detector_panel_transform', null);
        } else if (window.localStorage) {
          savedPos = JSON.parse(localStorage.getItem('ad_detector_panel_transform') || 'null');
        }
        if (savedPos && savedPos.x !== undefined && savedPos.y !== undefined) {
          currentTranslateX = savedPos.x;
          currentTranslateY = savedPos.y;
          panel.style.transform = `translate3d(${currentTranslateX}px, ${currentTranslateY}px, 0)`;
        }
      } catch (e) { }

      const startDrag = (e) => {
        if (e.target.closest('#btn-close-panel') || e.target.closest('.select-control')) return;
        if (e.button !== undefined && e.button !== 0) return;

        isDragging = true;
        startX = e.clientX;
        startY = e.clientY;

        startTranslateX = currentTranslateX;
        startTranslateY = currentTranslateY;

        document.body.style.userSelect = 'none';
        e.preventDefault();
      };

      const moveDrag = (e) => {
        if (!isDragging) return;

        const deltaX = e.clientX - startX;
        const deltaY = e.clientY - startY;

        currentTranslateX = startTranslateX + deltaX;
        currentTranslateY = startTranslateY + deltaY;

        panel.style.transform = `translate3d(${currentTranslateX}px, ${currentTranslateY}px, 0)`;
      };

      const stopDrag = () => {
        if (!isDragging) return;
        isDragging = false;

        document.body.style.userSelect = '';

        const posData = { x: currentTranslateX, y: currentTranslateY };
        try {
          if (typeof GM_setValue !== 'undefined') {
            GM_setValue('ad_detector_panel_transform', posData);
          } else if (window.localStorage) {
            localStorage.setItem('ad_detector_panel_transform', JSON.stringify(posData));
          }
        } catch (err) {
          console.warn('[AdDetector] 无法保存面板位置', err);
        }
      };

      const dragTargets = [header, ...edges];
      dragTargets.forEach((el) => {
        if (!el) return;
        el.addEventListener('pointerdown', startDrag);
      });

      window.addEventListener('pointermove', moveDrag);
      window.addEventListener('pointerup', stopDrag);
      window.addEventListener('pointercancel', stopDrag);
    }

    // 2. 节点高亮状态挂载（极轻量，单节点批量 class 变更）
    applyHighlight(el, enable, sizeText = '') {
      if (!el || el.dataset.overlayBlocked === 'true') {
        el.classList.remove('ad-detector-highlight-active', 'ad-detector-pos-relative');
        return;
      }

      if (enable) {
        // 处理相对定位，避免为 static 节点插入子级时定位偏离
        if (window.getComputedStyle(el).position === 'static') {
          el.classList.add('ad-detector-pos-relative');
        }

        // 更新或注入 Badge（只用 dataset 传参，避免每次创建/销毁 DOM 节点）
        let badge = el.querySelector(':scope > .ad-detector-size-badge');
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'ad-detector-size-badge';
          el.appendChild(badge);
        }

        if (!sizeText) {
          const adId = el.getAttribute('data-ad-detector-id');
          const meta = this.detectedAds.get(adId);
          sizeText = meta ? meta.size : '0x0px';
        }

        // 仅在尺寸变更时更新 Dataset，通过 CSS 伪元素 ::before 自行渲染 textContent
        if (badge.dataset.size !== sizeText) {
          badge.dataset.size = sizeText;
        }

        el.classList.add('ad-detector-highlight-active');
      } else {
        el.classList.remove('ad-detector-highlight-active', 'ad-detector-pos-relative');
      }
    }

    // 3. 一键切换高亮状态：借助 Map 极速遍历，无 DOM 树深度遍历
    toggleHighlight() {
      this.isHighlighted = !this.isHighlighted;
      for (const meta of this.detectedAds.values()) {
        if (meta.element && !meta.isBlocked) {
          this.applyHighlight(meta.element, this.isHighlighted, meta.size);
        }
      }
    }

    showPreviewWindow(adId) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element) return;

      const modal = this.shadow.querySelector('#preview-modal');
      const container = this.shadow.querySelector('#preview-container');
      const title = this.shadow.querySelector('#preview-title');
      const actionsContainer = this.shadow.querySelector('#preview-actions');

      title.textContent = `🔍 预览: <${meta.tagName}> (${meta.size})`;
      container.innerHTML = '';

      const cloneForCode = meta.element.cloneNode(true);
      cloneForCode.removeAttribute('data-ad-detector-id');
      const badgeInClone = cloneForCode.querySelector('.ad-detector-size-badge');
      if (badgeInClone) badgeInClone.remove();

      const rawHtml = cloneForCode.outerHTML;

      const iframe = document.createElement('iframe');
      iframe.style.setProperty('width', '100%', 'important');
      iframe.style.setProperty('height', '200px', 'important');
      iframe.style.setProperty('border', 'none', 'important');
      iframe.style.setProperty('background', 'transparent', 'important');

      container.appendChild(iframe);

      const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
      iframeDoc.open();
      iframeDoc.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="utf-8">
          <style>
            body {
              margin: 0;
              padding: 16px;
              display: flex;
              justify-content: center;
              align-items: center;
              min-height: 100vh;
              box-sizing: border-box;
              background: transparent;
              overflow: auto;
            }
          </style>
        </head>
        <body>
          <div id="iframe-preview-root"></div>
        </body>
        </html>
      `);
      iframeDoc.close();

      const iframeHead = iframeDoc.head;
      document.querySelectorAll('style').forEach((styleTag) => {
        if (styleTag.id !== 'ad-detector-global-styles' && styleTag.id !== 'ad-detector-dynamic-css-rules') {
          iframeHead.appendChild(styleTag.cloneNode(true));
        }
      });

      document.querySelectorAll('link[rel="stylesheet"]').forEach((linkTag) => {
        const clonedLink = linkTag.cloneNode(true);
        if (clonedLink.href) clonedLink.href = clonedLink.href;
        iframeHead.appendChild(clonedLink);
      });

      const origRect = meta.element.getBoundingClientRect();
      const origStyle = window.getComputedStyle(meta.element);
      const cloneForRender = cloneForCode.cloneNode(true);

      const finalWidth = origRect.width > 0 ? origRect.width : (parseInt(meta.size.split('x')[0]) || 300);
      const finalHeight = origRect.height > 0 ? origRect.height : (parseInt(meta.size.split('x')[1]) || 250);

      cloneForRender.style.setProperty('display', 'block', 'important');
      cloneForRender.style.setProperty('position', 'relative', 'important');
      cloneForRender.style.setProperty('visibility', 'visible', 'important');
      cloneForRender.style.setProperty('opacity', '1', 'important');
      cloneForRender.style.setProperty('transform', 'none', 'important');
      cloneForRender.style.setProperty('transition', 'none', 'important');
      cloneForRender.style.setProperty('margin', '0 auto', 'important');
      cloneForRender.style.setProperty('width', `${finalWidth}px`, 'important');
      cloneForRender.style.setProperty('height', `${finalHeight}px`, 'important');

      if (origStyle.backgroundColor && origStyle.backgroundColor !== 'rgba(0, 0, 0, 0)' && origStyle.backgroundColor !== 'transparent') {
        cloneForRender.style.setProperty('background-color', origStyle.backgroundColor, 'important');
      }

      const root = iframeDoc.getElementById('iframe-preview-root');
      root.appendChild(cloneForRender);

      let codeSection = this.shadow.querySelector('#preview-code-section');
      if (!codeSection) {
        const previewBody = this.shadow.querySelector('.preview-body');
        codeSection = document.createElement('div');
        codeSection.id = 'preview-code-section';
        codeSection.innerHTML = `
          <div class="preview-section-title">
            <span>📄 元素原代码 (HTML)</span>
            <button class="btn-copy-code" id="btn-copy-code">复制源码</button>
          </div>
          <div class="code-container" id="preview-code-container">
            <pre class="code-block" id="preview-code-block"></pre>
          </div>
        `;
        previewBody.appendChild(codeSection);
      }

      const codeBlock = this.shadow.querySelector('#preview-code-block');
      const copyBtn = this.shadow.querySelector('#btn-copy-code');

      codeBlock.textContent = rawHtml;

      copyBtn.onclick = () => {
        navigator.clipboard.writeText(codeBlock.textContent).then(() => {
          copyBtn.textContent = '已复制！';
          setTimeout(() => { copyBtn.textContent = '复制源码'; }, 1500);
        }).catch(err => {
          console.error('复制代码失败:', err);
        });
      };

      const renderPreviewActions = () => {
        if (!meta.isBlocked) {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-hide-single" id="btn-preview-hide">🚫 单独屏蔽</button>
          `;
          const btnHide = actionsContainer.querySelector('#btn-preview-hide');
          btnHide.onclick = () => {
            this.neutralizeSingle(adId);
            renderPreviewActions();
            setTimeout(() => {
              modal.style.display = 'none';
              container.innerHTML = '';
            }, 1200);
          };
        } else {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-restore-single" id="btn-preview-restore">↩️ 撤销屏蔽</button>
          `;
          const btnRestore = actionsContainer.querySelector('#btn-preview-restore');
          btnRestore.onclick = () => {
            this.restoreSingle(adId);
            renderPreviewActions();
          };
        }
      };

      renderPreviewActions();

      modal.style.display = 'flex';

      const closeBtn = this.shadow.querySelector('#btn-close-preview');
      closeBtn.onclick = () => {
        modal.style.display = 'none';
        container.innerHTML = '';
        this.updateUI();
      };
    }

    previewHoverElement(adId, isHovering) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element || meta.isBlocked) return;

      if (this.observer) {
        this.observer.disconnect();
      }

      if (isHovering) {
        meta.element.classList.add('ad-detector-hover-active');
      } else {
        meta.element.classList.remove('ad-detector-hover-active');

        if (!this.isHighlighted) {
          meta.element.style.removeProperty('outline');
          meta.element.style.removeProperty('box-shadow');
        } else {
          this.applyHighlight(meta.element, true, meta.size);
        }
      }

      if (this.observer && document.body) {
        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['style', 'class', 'src']
        });
      }
    }

    showToast(message) {
      if (!this.shadow) return;
      const toast = this.shadow.querySelector('#toast');
      toast.textContent = message;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
        //}, 2200);
      }, 3500);
    }

    bindInteractiveEvents() {
      const btnScan = this.shadow.querySelector('#btn-scan');
      const btnHl = this.shadow.querySelector('#btn-hl');
      const btnClean = this.shadow.querySelector('#btn-clean');
      const btnReset = this.shadow.querySelector('#btn-reset');
      const btnUndo = this.shadow.querySelector('#btn-undo');
      const btnRedo = this.shadow.querySelector('#btn-redo');
      const btnClose = this.shadow.querySelector('#btn-close-panel');
      const selectSort = this.shadow.querySelector('#select-sort');
      const selectFilter = this.shadow.querySelector('#select-filter');

      btnClose.onclick = () => this.hideUI();

      if (selectSort) {
        selectSort.value = this.sortType;
        selectSort.onchange = (e) => {
          this.sortType = e.target.value;
          this.updateUI();
        };
      }

      if (selectFilter) {
        selectFilter.value = this.filterType;
        selectFilter.onchange = (e) => {
          this.filterType = e.target.value;
          this.updateUI();
        };
      }

      btnScan.onclick = () => {
        btnScan.disabled = true;
        btnScan.textContent = '扫描中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            this.scan();
            btnScan.disabled = false;
            btnScan.textContent = '重新扫描';
            this.showToast('✅ 页面诊断完成');
          }, 50);
        });
      };

      btnHl.onclick = () => {
        this.toggleHighlight();
        if (this.isHighlighted) {
          btnHl.classList.add('active');
          this.showToast('🔴 已高亮标注高风险元素');
        } else {
          btnHl.classList.remove('active');
          this.showToast('⚪ 已还原元素标注');
        }
      };

      btnClean.onclick = () => {
        btnClean.disabled = true;
        btnClean.textContent = '屏蔽中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            const count = this.cleanAll();
            btnClean.disabled = false;
            btnClean.textContent = '一键屏蔽';
            this.showToast(`🛡 已成功屏蔽 ${count} 个威胁`);
          }, 50);
        });
      };

      btnReset.onclick = () => {
        btnReset.disabled = true;
        btnReset.textContent = '重置中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            const count = this.resetAll();
            btnReset.disabled = false;
            btnReset.textContent = '一键重置';
            this.showToast(`🔄 已重置规则并还原 ${count} 个元素`);
          }, 50);
        });
      };

      btnUndo.onclick = () => this.undo();
      btnRedo.onclick = () => this.redo();
    }

    updateUI() {
      if (!this.shadow) return;
      const listEl = this.shadow.querySelector('#list');
      const badge = this.shadow.querySelector('#count-badge');
      const btnUndo = this.shadow.querySelector('#btn-undo');
      const btnRedo = this.shadow.querySelector('#btn-redo');

      if (btnUndo) btnUndo.disabled = this.undoStack.length === 0;
      if (btnRedo) btnRedo.disabled = this.redoStack.length === 0;

      let allDetected = Array.from(this.detectedAds.values());
      const activeUnreadThreats = allDetected.filter((meta) => !meta.isBlocked);

      badge.textContent = `${activeUnreadThreats.length} 未处理 / 共 ${allDetected.length} 个`;

      if (allDetected.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:#30d158;padding:20px;">未发现高风险劫持或广告元素</div>';
        return;
      }

      if (this.filterType === 'unread') {
        allDetected = allDetected.filter((meta) => !meta.isBlocked);
      } else if (this.filterType === 'blocked') {
        allDetected = allDetected.filter((meta) => meta.isBlocked);
      }

      if (allDetected.length === 0) {
        const filterTextMap = { unread: '未处理', blocked: '已屏蔽' };
        listEl.innerHTML = `<div style="text-align:center;color:#8e8e93;padding:20px;">没有符合 [${filterTextMap[this.filterType] || '当前'}] 筛选条件的项</div>`;
        return;
      }

      const getArea = (sizeStr) => {
        if (!sizeStr) return 0;
        const match = sizeStr.match(/(\d+)x(\d+)/);
        if (match) {
          return parseInt(match[1], 10) * parseInt(match[2], 10);
        }
        return 0;
      };

      allDetected.sort((a, b) => {
        if (this.sortType === 'size-desc') {
          return getArea(b.size) - getArea(a.size);
        } else if (this.sortType === 'size-asc') {
          return getArea(a.size) - getArea(b.size);
        }
        return b.score - a.score;
      });

      let html = '';
      allDetected.forEach((meta) => {
        const isBlocked = meta.isBlocked;

        html += `
          <div class="item ${isBlocked ? 'is-blocked' : ''}" data-ad-id="${meta.id}">
            <div class="item-top">
              <div class="item-title">
                <strong>${meta.tagName}</strong>
                <span style="color:#8e8e93;">(${meta.size})</span>
              </div>
              ${isBlocked ? '<span class="status-tag">已屏蔽</span>' : `<span class="score">${meta.score}分</span>`}
            </div>
            <div style="font-size:11px;color:#0a84ff;word-break:break-all;margin-top:2px;">${meta.classAndId || '无 Class/ID'}</div>
            <div class="reasons">原因: ${meta.reasons.join(' | ')}</div>
            <div class="actions">
              ${!isBlocked
            ? `<button class="btn-action btn-preview" data-action="preview" data-id="${meta.id}">🔍 预览元素</button>
                   <button class="btn-action btn-hide-single" data-action="hide" data-id="${meta.id}">🚫 单独屏蔽</button>`
            : `<button class="btn-action btn-restore-single" data-action="restore" data-id="${meta.id}">↩️ 撤销屏蔽</button>`
          }
            </div>
          </div>
        `;
      });
      listEl.innerHTML = html;

      listEl.querySelectorAll('.item').forEach((item) => {
        const adId = item.getAttribute('data-ad-id');

        item.addEventListener('pointerenter', (e) => {
          e.stopPropagation();
          this.previewHoverElement(adId, true);
        });

        item.addEventListener('pointerleave', (e) => {
          e.stopPropagation();
          this.previewHoverElement(adId, false);
        });

        item.addEventListener('click', (e) => {
          const btn = e.target.closest('.btn-action');
          if (!btn) return;

          const action = btn.getAttribute('data-action');
          const id = btn.getAttribute('data-id');

          if (action === 'preview') {
            this.showPreviewWindow(id);
          } else if (action === 'hide') {
            this.neutralizeSingle(id);
          } else if (action === 'restore') {
            this.restoreSingle(id);
          }
        });
      });
    }
  }

  // 单例挂载
  let instance = null;
  function getDetector() {
    if (!instance) {
      instance = new UniversalAdDetector();
    }
    return instance;
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => getDetector());
  } else {
    getDetector();
  }

  // 绑定至全局 window 对象
  globalWin.toggleAdDetectorUI = function () {
    getDetector().toggleUI();
  };

  globalWin.showAdDetectorUI = function () {
    getDetector().showUI();
  };

  globalWin.hideAdDetectorUI = function () {
    getDetector().hideUI();
  };

  globalWin.cleanAdsSilently = function () {
    return getDetector().cleanAll();
  };

})();