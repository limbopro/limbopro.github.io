// ==UserScript==
// @name         智能广告与覆盖层检测器 (Silent Backend + Floating UI)
// @namespace    https://tampermonkey.net/
// @version      12.5
// @description  默认静默后台防护，支持捕捉全屏透明/半透明遮罩与拦截内联/动态绑定事件劫持，包含特异性选择器生成、数量交叉校验降级防护与持久化规则恢复。
// @author       Assistant
// @match        *://*/*
// @grant        GM_addStyle
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  // 跨沙盒全局 window 挂载对象
  const globalWin = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

  class UniversalAdDetector {
    constructor() {
      this.detectedAds = new Map();
      this.animatedGifCache = new Map();
      this.counter = 0;
      this.isHighlighted = false;
      this.isScanning = false;
      this.scanTimer = null;
      this.observer = null;

      // 撤回 (Undo) 与 重做 (Redo) 堆栈
      this.undoStack = [];
      this.redoStack = [];

      // 排序与筛选模式
      this.sortType = 'default'; // 'default' | 'size-desc' | 'size-asc'
      this.filterType = 'all'; // 'all' | 'unread' | 'blocked'

      // 面板显示状态标识
      this.host = null;
      this.shadow = null;

      // 域隔离持久化规则库
      this.storageKey = `ad_detector_blocked_${window.location.hostname}`;
      this.blockedRules = this.loadBlockedRules();

      // 读取上次页面留下的面板开启状态
      this.isUIVisible = this.loadUIVisibleState();

      // 拦截内联与动态事件劫持防护机制
      this.initClickHijackProtection();

      this.injectGlobalStyles();
      this.applyCssRulesFromStorage(); // 持久化 CSS 规则转译
      this.initObserver();
      this.bindGlobalHotkeys();

      // 立即强制触发 1 次同步全盘清理与持久化规则恢复
      this.forceCleanSavedRulesImmediately();

      // 如果记忆状态为开启，页面加载时自动显示面板
      if (this.isUIVisible) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => this.showUI());
        } else {
          this.showUI();
        }
      }
    }

    // ==========================================
    // ★ 模块一：精准特异性选择器生成器
    // ==========================================
    generateSpecificSelector(el) {
      if (!el || el.nodeType !== Node.ELEMENT_NODE) return '';

      // 1. 如果存在稳固的 ID（过滤纯数字/随机长字串 ID）
      if (el.id && !/\d{5,}/.test(el.id)) {
        return `#${CSS.escape(el.id)}`;
      }

      const path = [];
      let current = el;

      while (current && current.nodeType === Node.ELEMENT_NODE && current !== document.body && current !== document.documentElement) {
        let selector = current.tagName.toLowerCase();

        // 过滤掉动态/无意义 class，保留有辨识度的 class
        const validClasses = Array.from(current.classList || []).filter(
          c => !/^[0-9_-]+$/.test(c) && !/^(active|show|hide|visible|hover|focus|ad-detector-)/.test(c)
        );

        if (validClasses.length > 0) {
          selector += `.${validClasses.map(c => CSS.escape(c)).join('.')}`;
        }

        // 拼接特征属性约束（如 data-ad-id, href 等）
        if (current.hasAttribute('data-ad-id')) {
          selector += `[data-ad-id="${CSS.escape(current.getAttribute('data-ad-id'))}"]`;
        } else if (current.tagName === 'A' && current.hasAttribute('href')) {
          const href = current.getAttribute('href');
          if (href && href.length < 60) {
            selector += `[href="${CSS.escape(href)}"]`;
          }
        }

        // 追加同级节点 index 约束
        let sibling = current;
        let nth = 1;
        while ((sibling = sibling.previousElementSibling)) {
          if (sibling.tagName === current.tagName) nth++;
        }
        if (nth > 1) {
          selector += `:nth-of-type(${nth})`;
        }

        path.unshift(selector);
        current = current.parentElement;

        // 路径向上溯源到 3 层时提前终止，防止选择器过长
        if (path.length >= 3) break;
      }

      return path.join(' > ');
    }

    // ==========================================
    // ★ 模块二：生成绝对精确的 XPath（降级备份用）
    // ==========================================
    getElementXPath(element) {
      if (!element) return '';
      if (element.id && !/\d{5,}/.test(element.id)) return `//*[@id="${element.id}"]`;
      if (element === document.body) return '/html/body';

      let ix = 0;
      const siblings = element.parentNode ? element.parentNode.childNodes : [];

      for (let i = 0; i < siblings.length; i++) {
        const sibling = siblings[i];
        if (sibling === element) {
          return `${this.getElementXPath(element.parentNode)}/${element.tagName.toLowerCase()}[${ix + 1}]`;
        }
        if (sibling.nodeType === 1 && sibling.tagName === element.tagName) {
          ix++;
        }
      }
      return '';
    }

    // ==========================================
    // ★ 撤回 (Undo) / 重做 (Redo) 核心逻辑
    // ==========================================
    pushHistoryState(action) {
      this.undoStack.push(action);
      this.redoStack = [];
      this.updateUI();
    }

    undo() {
      if (this.undoStack.length === 0) return;
      const action = this.undoStack.pop();

      if (action.type === 'SINGLE_BLOCK' || action.type === 'BATCH_BLOCK') {
        action.items.forEach(adId => this.restoreSingleInternal(adId));
        this.showToast(`↩ 已撤回屏蔽操作 (${action.items.length} 个元素)`);
      } else if (action.type === 'SINGLE_RESTORE') {
        action.items.forEach(adId => this.neutralizeSingleInternal(adId));
        this.showToast(`↩ 已撤回恢复操作 (${action.items.length} 个元素)`);
      }

      this.redoStack.push(action);
      this.updateUI();
    }

    redo() {
      if (this.redoStack.length === 0) return;
      const action = this.redoStack.pop();

      if (action.type === 'SINGLE_BLOCK' || action.type === 'BATCH_BLOCK') {
        action.items.forEach(adId => this.neutralizeSingleInternal(adId));
        this.showToast(`↪️ 已重做屏蔽操作 (${action.items.length} 个元素)`);
      } else if (action.type === 'SINGLE_RESTORE') {
        action.items.forEach(adId => this.restoreSingleInternal(adId));
        this.showToast(`↪️ 已重做恢复操作 (${action.items.length} 个元素)`);
      }

      this.undoStack.push(action);
      this.updateUI();
    }

    // ==========================================
    // ★ 模块三 & 四：safeBlockElement 安全屏蔽 + 交叉校验 + 降级 + 规则持久化
    // ==========================================
    neutralizeSingleInternal(adId) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element) return;

      const targetEl = meta.element;
      meta.isBlocked = true;
      targetEl.dataset.overlayBlocked = 'true';

      this.applyHighlight(targetEl, false);

      // 1. 生成候选 CSS 选择器
      const candidateSelector = this.generateSpecificSelector(targetEl);

      // 2. 数量交叉校验
      // 计算预期匹配数 (N_expected)
      let N_expected = 0;
      this.detectedAds.forEach(item => {
        if (item.element === targetEl || (candidateSelector && this.generateSpecificSelector(item.element) === candidateSelector)) {
          N_expected++;
        }
      });
      N_expected = Math.max(1, N_expected);

      // 计算实际 DOM 匹配数 (N_actual)
      let matchedElements = [];
      try {
        if (candidateSelector) {
          matchedElements = document.querySelectorAll(candidateSelector);
        }
      } catch (e) {
        console.warn('[AdDetector] 选择器语法异常:', candidateSelector, e);
      }

      const N_actual = matchedElements.length;

      // 3. 判定分流与降级策略执行
      if (N_actual > 0 && N_actual <= N_expected) {
        // 【分支 A：完全匹配/更精准】 -> 全局 CSS 注入 + 写入 CSS 规则
        targetEl.style.setProperty('display', 'none', 'important');
        matchedElements.forEach(el => el.style.setProperty('display', 'none', 'important'));

        const rule = {
          type: 'css',
          selector: candidateSelector,
          classAndId: meta.classAndId,
          tagName: meta.tagName,
          size: meta.size,
          fingerprint: meta.fingerprint
        };

        if (!this.blockedRules.some(r => r.selector === candidateSelector || r.fingerprint === rule.fingerprint)) {
          this.blockedRules.push(rule);
          this.saveBlockedRules();
        }
      } else {
        // 【分支 B：实际匹配超标，存在误伤风险】 -> 降级为单节点内联隐藏 + 精准 XPath 规则
        console.warn(`[AdDetector] 误伤预警: "${candidateSelector}" 实际匹配 ${N_actual} 个, 预期 ${N_expected} 个。执行单节点 XPath 降级。`);

        targetEl.style.setProperty('display', 'none', 'important');
        const exactXPath = this.getElementXPath(targetEl);

        const rule = {
          type: 'xpath',
          xpath: exactXPath,
          classAndId: meta.classAndId,
          tagName: meta.tagName,
          size: meta.size,
          fingerprint: meta.fingerprint
        };

        if (!this.blockedRules.some(r => r.xpath === exactXPath || r.fingerprint === rule.fingerprint)) {
          this.blockedRules.push(rule);
          this.saveBlockedRules();
        }
      }
    }

    // 内部恢复逻辑
    restoreSingleInternal(adId) {
      const meta = this.detectedAds.get(adId);
      if (meta && meta.element) {
        meta.isBlocked = false;
        delete meta.element.dataset.overlayBlocked;

        meta.element.style.removeProperty('display');

        if (this.isHighlighted) {
          this.applyHighlight(meta.element, true, meta.size);
        }

        const currentSelector = this.generateSpecificSelector(meta.element);
        const currentXPath = this.getElementXPath(meta.element);

        this.blockedRules = this.blockedRules.filter(
          (r) => !(
            (r.selector && r.selector === currentSelector) ||
            (r.xpath && r.xpath === currentXPath) ||
            (r.fingerprint && r.fingerprint === meta.fingerprint) ||
            (r.classAndId && r.classAndId === meta.classAndId)
          )
        );
        this.saveBlockedRules();
      }
    }

    neutralizeSingle(adId) {
      const meta = this.detectedAds.get(adId);
      if (meta && !meta.isBlocked) {
        this.neutralizeSingleInternal(adId);
        this.pushHistoryState({ type: 'SINGLE_BLOCK', items: [adId] });
        this.showToast('🛡 已通过安全交叉校验执行屏蔽');
      }
    }

    restoreSingle(adId) {
      const meta = this.detectedAds.get(adId);
      if (meta && meta.isBlocked) {
        this.restoreSingleInternal(adId);
        this.pushHistoryState({ type: 'SINGLE_RESTORE', items: [adId] });
        this.showToast('↩️ 已撤销屏蔽，已更新本地规则库');
      }
    }

    cleanAll() {
      const blockedIds = [];
      this.detectedAds.forEach((meta) => {
        if (meta.element && !meta.isBlocked) {
          this.neutralizeSingleInternal(meta.id);
          blockedIds.push(meta.id);
        }
      });

      if (blockedIds.length > 0) {
        this.pushHistoryState({ type: 'BATCH_BLOCK', items: blockedIds });
      }
      return blockedIds.length;
    }

    resetAll() {
      this.blockedRules = [];
      this.saveBlockedRules();

      let count = 0;
      this.detectedAds.forEach((meta) => {
        if (meta.isBlocked) {
          meta.isBlocked = false;
          count++;
          if (meta.element) {
            delete meta.element.dataset.overlayBlocked;
            meta.element.style.removeProperty('display');
            if (this.isHighlighted) {
              this.applyHighlight(meta.element, true, meta.size);
            }
          }
        }
      });

      this.undoStack = [];
      this.redoStack = [];

      this.updateUI();
      return count;
    }

    loadUIVisibleState() {
      try {
        if (typeof GM_getValue !== 'undefined') {
          return GM_getValue('ad_detector_ui_open', false);
        } else if (window.localStorage) {
          return localStorage.getItem('ad_detector_ui_open') === 'true';
        }
      } catch (e) {
        console.warn('[AdDetector] 读取面板状态失败:', e);
      }
      return false;
    }

    saveUIVisibleState(isOpen) {
      try {
        if (typeof GM_setValue !== 'undefined') {
          GM_setValue('ad_detector_ui_open', isOpen);
        } else if (window.localStorage) {
          localStorage.setItem('ad_detector_ui_open', isOpen ? 'true' : 'false');
        }
      } catch (e) {
        console.warn('[AdDetector] 保存面板状态失败:', e);
      }
    }

    initClickHijackProtection() {
      window.addEventListener('click', (e) => {
        const path = e.composedPath ? e.composedPath() : [];
        for (let el of path) {
          if (!el || el === window || el === document) continue;
          if (this.isExcludedElement(el)) continue;

          if (el.dataset && el.dataset.overlayBlocked === 'true') {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            console.warn('[AdDetector] 已拦截针对被屏蔽元素的点击劫持行为:', el);
            return false;
          }

          if (el.tagName === 'A' || el.hasAttribute('onclick')) {
            const onclickAttr = el.getAttribute('onclick') || '';
            const hrefAttr = el.getAttribute('href') || '';

            const isSuspiciousOnclick = /(window|self|top)\.open|location\.(href|replace|assign)|click/i.test(onclickAttr);
            const isSuspiciousHref = /^javascript\s*:/i.test(hrefAttr) || /(\/|\?)(goto|redirect|out|click|jump|target=|\?url=|\&url=)/i.test(hrefAttr);

            const style = window.getComputedStyle(el);
            if ((isSuspiciousOnclick || isSuspiciousHref) && (style.position === 'fixed' || style.position === 'absolute') && parseFloat(style.opacity) < 0.2) {
              e.preventDefault();
              e.stopPropagation();
              e.stopImmediatePropagation();
              console.warn('[AdDetector] 已精准拦截高风险透明点击劫持事件:', el);
              this.neutralizeSingle(el.getAttribute('data-ad-detector-id') || this.registerAdElement(el));
              return false;
            }
          }
        }
      }, true);
    }

    registerAdElement(el) {
      this.counter++;
      const adId = `ad-detected-${this.counter}`;
      el.setAttribute('data-ad-detector-id', adId);
      return adId;
    }

    loadBlockedRules() {
      try {
        let raw = null;
        if (typeof GM_getValue !== 'undefined') {
          raw = GM_getValue(this.storageKey, '[]');
        } else if (window.localStorage) {
          raw = localStorage.getItem(this.storageKey) || '[]';
        }
        const rules = JSON.parse(raw || '[]');
        console.log(`[AdDetector] 已加载 ${rules.length} 条本地持久化规则`);
        return rules;
      } catch (e) {
        console.warn('[AdDetector] 读取本地存储规则失败，回退为空:', e);
        return [];
      }
    }

    saveBlockedRules() {
      try {
        const data = JSON.stringify(this.blockedRules);
        if (typeof GM_setValue !== 'undefined') {
          GM_setValue(this.storageKey, data);
        } else if (window.localStorage) {
          localStorage.setItem(this.storageKey, data);
        }
        this.applyCssRulesFromStorage();
      } catch (e) {
        console.error('[AdDetector] 保存持久化规则失败:', e);
      }
    }

    // ==========================================
    // ★ 应用 CSS 屏蔽规则 + 履约 XPath 降级规则
    // ==========================================
    applyCssRulesFromStorage() {
      let styleEl = document.getElementById('ad-detector-dynamic-css-rules');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'ad-detector-dynamic-css-rules';
        (document.head || document.documentElement).appendChild(styleEl);
      }

      const cssSelectors = [];
      this.blockedRules.forEach((rule) => {
        if (rule.type === 'css' && rule.selector) {
          cssSelectors.push(rule.selector);
        } else if (rule.classAndId && rule.classAndId !== '无 Class/ID') {
          const formattedSelector = rule.classAndId
            .split(' ')
            .filter(Boolean)
            .map(cls => cls.startsWith('#') ? cls : '.' + CSS.escape(cls.replace(/^\./, '')))
            .join('');
          if (formattedSelector) {
            cssSelectors.push(`${formattedSelector}`);
          }
        }

        // 履约 XPath 类型的规则
        if (rule.type === 'xpath' && rule.xpath) {
          try {
            const result = document.evaluate(rule.xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null);
            if (result.singleNodeValue) {
              result.singleNodeValue.style.setProperty('display', 'none', 'important');
              result.singleNodeValue.dataset.overlayBlocked = 'true';
            }
          } catch (e) { }
        }
      });

      if (cssSelectors.length > 0) {
        styleEl.textContent = `${cssSelectors.join(', ')} { display: none !important; visibility: hidden !important; opacity: 0 !important; pointer-events: none !important; }`;
      } else {
        styleEl.textContent = '';
      }
    }

    isMatchesBlockedRule(meta) {
      const currentSelector = meta.element ? this.generateSpecificSelector(meta.element) : '';
      const currentXPath = meta.element ? this.getElementXPath(meta.element) : '';

      return this.blockedRules.some((rule) => {
        if (rule.selector && currentSelector && rule.selector === currentSelector) return true;
        if (rule.xpath && currentXPath && rule.xpath === currentXPath) return true;
        if (rule.classAndId && meta.classAndId && rule.classAndId === meta.classAndId && meta.classAndId !== '无 Class/ID') return true;
        if (rule.fingerprint && meta.fingerprint && rule.fingerprint === meta.fingerprint) return true;
        if (rule.tagName === meta.tagName && rule.size === meta.size && rule.size !== '0x0px') {
          const ruleHost = (rule.fingerprint || '').split('_')[2] || '';
          const metaHost = (meta.fingerprint || '').split('_')[2] || '';
          if (ruleHost && metaHost && ruleHost === metaHost) return true;
        }
        return false;
      });
    }

    forceCleanSavedRulesImmediately() {
      const doScan = () => {
        this.scan();
        this.detectedAds.forEach((meta) => {
          if (this.isMatchesBlockedRule(meta)) {
            meta.isBlocked = true;
            if (meta.element) {
              meta.element.dataset.overlayBlocked = 'true';
              meta.element.style.setProperty('display', 'none', 'important');

              if (!meta.element._adLockObserver) {
                meta.element._adLockObserver = new MutationObserver((mutations) => {
                  if (meta.isBlocked && meta.element.style.display !== 'none') {
                    meta.element._adLockObserver.disconnect();
                    meta.element.style.setProperty('display', 'none', 'important');
                    meta.element._adLockObserver.observe(meta.element, {
                      attributes: true,
                      attributeFilter: ['style', 'class']
                    });
                  }
                });
                meta.element._adLockObserver.observe(meta.element, {
                  attributes: true,
                  attributeFilter: ['style', 'class']
                });
              }

            }
          }
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', doScan);
      } else {
        doScan();
      }
    }

    // 1. 全局样式注入：统一用 CSS 定义高亮及角标样式
    injectGlobalStyles() {
      if (document.getElementById('ad-detector-global-styles')) return;
      const style = document.createElement('style');
      style.id = 'ad-detector-global-styles';
      style.textContent = `
    /* 容器高亮控制类 */
    .ad-detector-highlight-active {
      outline: 3px solid #ff3b30 !important;
      background-color: rgba(255, 59, 48, 0.2) !important;
    }

    /* 针对 static 定位元素的基准修复 */
    .ad-detector-pos-relative {
      position: relative !important;
    }

    /* hover 态预热 */
    .ad-detector-hover-active {
      outline: 8px dashed #f21414 !important;
      outline-offset: -2px !important;
      z-index: 999999 !important;
      pointer-events: auto !important;
    }

    /* 优化后的 Size Badge：基于 CSS content 属性动态渲染尺寸文本 */
    .ad-detector-size-badge {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      background: #ff3b30 !important;
      color: #ffffff !important;
      font-size: 11px !important;
      font-weight: 700 !important;
      padding: 2px 6px !important;
      border-bottom-right-radius: 6px !important;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3) !important;
      z-index: 2147483645 !important;
      pointer-events: none !important;
      white-space: nowrap !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      line-height: 1.2 !important;
      display: none !important;
    }

    /* 仅当父级带有高亮激活类且未被屏蔽时，显示角标 */
    .ad-detector-highlight-active > .ad-detector-size-badge {
      display: block !important;
    }

    .ad-detector-size-badge::before {
      content: attr(data-size);
    }
  `;
      (document.head || document.documentElement).appendChild(style);
    }

    bindGlobalHotkeys() {
      window.addEventListener('keydown', (e) => {
        if (e.altKey && (e.code === 'KeyA' || e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          this.toggleUI();
        }
      });
    }

    isExcludedElement(el) {
      if (!el) return true;

      if (el.id === 'dh_pageContainer' || el.closest('#dh_pageContainer')) return true;
      if (el.id === 'ad-detector-host' || el.closest('#ad-detector-host')) return true;
      if (el.id === 'previewContainer' || el.closest('#previewContainer')) return true;

      if (el.closest('a[href*="limbopro.com"]')) return true;

      const excludeRegex = /\b(limbo|notranslate)\b|limbo-/i;

      let curr = el;
      while (curr && curr !== document.documentElement) {
        const classAndId = `${curr.id || ''} ${curr.className || ''}`;
        if (excludeRegex.test(classAndId)) {
          return true;
        }
        curr = curr.parentElement;
      }

      return false;
    }

    isLegitimateElement(el) {
      if (!el || el === document.body || el === document.documentElement) return true;
      if (this.isExcludedElement(el)) return true;
      if (el.querySelector('input, textarea, select, button, [role="dialog"], [aria-modal="true"]')) return true;
      const role = el.getAttribute('role');
      if (['main', 'navigation', 'search', 'dialog'].includes(role)) return true;
      return false;
    }

    getMainDomain(hostname) {
      if (!hostname) return '';
      const parts = hostname.split('.').filter(Boolean);
      if (parts.length <= 2) return hostname;
      return parts.slice(-2).join('.');
    }

    async isAnimatedGif(url) {
      if (!url) return false;
      if (this.animatedGifCache.has(url)) {
        return this.animatedGifCache.get(url);
      }

      if (url.startsWith('data:image/gif;base64,') || url.startsWith('data:image/base64,')) {
        try {
          const base64Data = url.split(',')[1];
          const binaryString = atob(base64Data.slice(0, 2000));
          let frameCount = 0;
          for (let i = 0; i < binaryString.length - 2; i++) {
            if (binaryString.charCodeAt(i) === 0x21 && binaryString.charCodeAt(i + 1) === 0xf9) {
              frameCount++;
              if (frameCount > 1) {
                this.animatedGifCache.set(url, true);
                return true;
              }
            }
          }
          this.animatedGifCache.set(url, false);
          return false;
        } catch (e) {
          this.animatedGifCache.set(url, false);
          return false;
        }
      }

      try {
        const response = await fetch(url, { headers: { Range: 'bytes=0-2048' } });
        const buffer = await response.arrayBuffer();
        const bytes = new Uint8Array(buffer);

        const header = String.fromCharCode(...bytes.subarray(0, 6));
        if (!header.startsWith('GIF')) {
          this.animatedGifCache.set(url, false);
          return false;
        }

        let frameCount = 0;
        for (let i = 0; i < bytes.length - 2; i++) {
          if (bytes[i] === 0x21 && bytes[i + 1] === 0xf9) {
            frameCount++;
            if (frameCount > 1) {
              this.animatedGifCache.set(url, true);
              return true;
            }
          }
        }
        this.animatedGifCache.set(url, false);
        return false;
      } catch (e) {
        this.animatedGifCache.set(url, false);
        return false;
      }
    }

    calculateAdScore(el) {
      if (this.isLegitimateElement(el)) return { score: 0, reasons: [] };

      const style = window.getComputedStyle(el);

      if (style.pointerEvents === 'none' || style.display === 'none' || style.visibility === 'hidden') {
        if (el.dataset.overlayBlocked === 'true') {
          const isSavedRule = this.isMatchesBlockedRule({
            element: el,
            classAndId: `${el.id ? '#' + el.id : ''}${el.className ? '.' + el.className : ''}`.trim(),
            fingerprint: `${el.tagName.toLowerCase()}_${el.offsetWidth}x${el.offsetHeight}px_`
          });

          const blockReason = isSavedRule ? '匹配历史持久化规则自动屏蔽' : '已被当前会话手动屏蔽';

          return {
            score: 100,
            reasons: [`${blockReason}（若影响页面功能可点击撤销）`]
          };
        }
        return { score: 0, reasons: [] };
      }

      let score = 0;
      const reasons = [];

      const rect = el.getBoundingClientRect();
      if (rect.width === 0 && rect.height === 0) return { score: 0, reasons: [] };

      const vw = window.innerWidth || document.documentElement.clientWidth;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const viewportArea = vw * vh;

      const originHost = window.location.hostname;
      const currentMainDomain = this.getMainDomain(originHost);

      const allAnchors = Array.from(el.querySelectorAll('a[href]'));
      let sameDomainLinkCount = 0;
      let crossDomainLinkCount = 0;

      allAnchors.forEach(a => {
        try {
          const u = new URL(a.href, window.location.href);
          if (this.getMainDomain(u.hostname) === currentMainDomain && !u.protocol.startsWith('javascript')) {
            sameDomainLinkCount++;
          } else {
            crossDomainLinkCount++;
          }
        } catch (e) { }
      });

      if (sameDomainLinkCount >= 2) {
        return { score: 0, reasons: ['容器内包含多个站内正常链接，判定为合法内容板块'] };
      }

      const adWordRegex = /(^|[-_ \/])(ad|ads|advert|advertising|advertisement|banner|popup|pop|backdrop|overlay|mask|modal|dialog|sponsor|sponsored|promoted|promo|guanggao|gg|float|floatad|float-ad|couplet|duilian|billboard|paster|sticky-ad|recommend-ad|right-ad|top-ad|bottom-ad|side-ad)([-_ \/]|s?$)/i;

      const classAndId = `${el.id || ''} ${el.className || ''}`;
      if (adWordRegex.test(classAndId)) {
        score += 35;
        reasons.push('Class/ID 命中广告/遮罩关键词');
      }

      const areaRatio = (rect.width * rect.height) / (viewportArea || 1);
      const isPositioned = style.position === 'fixed' || style.position === 'absolute';
      const zIndex = parseInt(style.zIndex, 10) || 0;

      const iabSizes = [[728, 90], [300, 250], [336, 280], [160, 600], [300, 600], [970, 90], [320, 50]];
      const isIABSize = iabSizes.some(([w, h]) => Math.abs(rect.width - w) <= 6 && Math.abs(rect.height - h) <= 6);
      if (isIABSize) {
        score += 30;
        reasons.push('符合 IAB 标准广告尺寸');
      }

      if ((style.position === 'fixed' || style.position === 'sticky') && zIndex > 50) {
        if (rect.height < 260 && (rect.top <= 10 || rect.bottom >= vh - 10)) {
          score += 30;
          reasons.push('顶/底悬浮贴片弹窗');
        }
      }

      const imgEl = el.tagName === 'IMG' ? el : el.querySelector('img');
      if (imgEl) {
        const imgSrc = imgEl.currentSrc || imgEl.src || '';
        const imgAlt = imgEl.getAttribute('alt') || '';
        const isBase64Gif = imgSrc.startsWith('data:image/gif;base64,') || imgSrc.startsWith('data:image/base64,');
        const isNetGif = /\.gif($|\?)/i.test(imgSrc) || imgSrc.includes('format=gif');

        if (/(广告|横幅|推广|赞助|sponsor|promoted|banner|ad)/i.test(imgAlt)) {
          score += 40;
          reasons.push(`图片 Alt 属性命中广告描述 ("${imgAlt}")`);
        }

        if (/\/promo\/|\/ad[s_]?\d*|\/advert/i.test(imgSrc)) {
          score += 35;
          reasons.push('图片链接路径包含广告/推广目录 (/promo/或/ad_)');
        }

        if (isBase64Gif || isNetGif) {
          if (isBase64Gif) {
            score += 25;
            reasons.push('使用 Base64 Data-URI 格式内嵌 GIF');
            if (imgSrc.includes('R0lGODlh')) {
              score += 15;
              reasons.push('匹配标准 GIF Base64 编码头部');
            }
          }

          if (isNetGif && /ad|banner|union|pop|sp|delivery|gg|float/i.test(imgSrc)) {
            score += 30;
            reasons.push('GIF 路径包含广告/网盟关键字');
          }

          if (this.animatedGifCache.get(imgSrc) === true) {
            score += 25;
            reasons.push('检测到多帧动态 GIF (High Attention)');
          } else {
            this.isAnimatedGif(imgSrc).then((isAnim) => {
              if (isAnim && !this.isScanning) {
                this.scan();
              }
            });
          }
        }
      }

      const badgeEl = el.querySelector('span, div, em, i');
      if (badgeEl) {
        const badgeText = (badgeEl.textContent || '').trim();
        if (/^(AD|广告|赞助|推广)$/i.test(badgeText)) {
          score += 45;
          reasons.push(`匹配到独立的角标文本 ("${badgeText}")`);
        }
      }

      if (el.tagName === 'IFRAME') {
        const src = el.src || '';
        if (src && !src.startsWith(window.location.origin) && !src.startsWith('about:')) {
          score += 25;
          reasons.push('跨域 iframe 嵌套');
        }
        if (/pos|slot|pagead|doubleclick|union|ssp|popunder|m3u8|embed/i.test(src)) {
          score += 35;
          reasons.push('匹配网盟或可疑外链 iframe');
        }
      }

      const anchor = el.tagName === 'A' ? el : (allAnchors[0] || null);
      if (anchor) {
        const rawHref = anchor.getAttribute('href') || '';

        const suspiciousRedirectRegex = /(\/|\?)(go|goto|redirect|out|click|jump|target|url|link|visit)(\/|\?|=|_)/i;
        if (suspiciousRedirectRegex.test(rawHref)) {
          score += 35;
          reasons.push(`命中站内重定向/广告跳转路径 ("${rawHref.slice(0, 30)}...")`);
        }

        if (/\/go\/[A-Za-z0-9%_\-~]{20,}/i.test(rawHref)) {
          score += 25;
          reasons.push('检测到长串 Base64 加密型广告跳转链接');
        }

        if (rawHref === '#' || rawHref.startsWith('javascript:')) {
          if (isPositioned && areaRatio > 0.05) {
            score += 50;
            reasons.push('透明/伪装点击劫持 (JS/空链接)');
          }
        }

        const redirectPattern = /(\/|\?)(goto|redirect|out|click|jump|target=|\?url=|\&url=)/i;
        if (redirectPattern.test(rawHref)) {
          score += 30;
          reasons.push('站内隐蔽重定向跳转链接');
        }

        try {
          const targetUrl = new URL(anchor.href, window.location.href);
          const targetMainDomain = this.getMainDomain(targetUrl.hostname);

          if (targetMainDomain && targetMainDomain !== currentMainDomain && !targetUrl.protocol.startsWith('javascript')) {
            let linkScore = 35;
            let linkReason = `跨域外链 (${targetUrl.hostname})`;
            if (anchor.target === '_blank') {
              linkScore += 15;
              linkReason += ' + _blank';
            }

            const img = anchor.querySelector('img');
            if (img) {
              linkScore += 10;
              const imgSrc = img.getAttribute('src') || '';
              if (imgSrc.startsWith('data:image/') || /\.gif($|\?)/i.test(imgSrc)) {
                linkReason += ' + GIF/Base64 动图跳转';
              } else {
                linkReason += ' + 图片占位';
              }
            }

            if (el.tagName !== 'A') {
              if (sameDomainLinkCount > 0) {
                linkScore = Math.floor(linkScore * 0.2);
                linkReason += ' (父容器含正常链接，大幅削减权重)';
              } else if (el.childElementCount > 3) {
                linkScore = Math.floor(linkScore * 0.5);
                linkReason += ' (父节点包含多元素，权重半折)';
              }
            }

            score += linkScore;
            reasons.push(linkReason);
          }
        } catch (e) { }

        const textContent = (anchor.textContent || '').trim();
        if (textContent) {
          const highRiskRegex = /(裸聊|菠菜|博彩|荷官|约炮|黄播|六合|反波胆|爆率|必中|挂机|刷单|🈲|🔞)/i;
          const mediumRiskRegex = /(免费看|激情|性感|棋牌|投注|充值|特惠|点击看|加微信|私聊|App下载|点击播放|同城|福利|兼职|日赚|提现|领红包|免费领|加薇|加V|Vx|v信)/i;

          let wordScore = 0;
          let matchedWord = '';

          if (highRiskRegex.test(textContent)) {
            wordScore = 35;
            matchedWord = textContent.match(highRiskRegex)[0];
          } else if (mediumRiskRegex.test(textContent)) {
            wordScore = 15;
            matchedWord = textContent.match(mediumRiskRegex)[0];
          }

          if (wordScore > 0) {
            if (el.tagName !== 'A' && sameDomainLinkCount > 0) {
              wordScore = Math.floor(wordScore * 0.3);
            }
            score += wordScore;
            reasons.push(`命中诱导敏感词 ("${matchedWord}")`);
          }
        }
      }

      if (sameDomainLinkCount > 0 && crossDomainLinkCount > 0) {
        const totalLinks = sameDomainLinkCount + crossDomainLinkCount;
        const normalRatio = sameDomainLinkCount / totalLinks;
        const deduction = Math.floor(score * normalRatio);
        score -= deduction;
        reasons.push(`混有 ${sameDomainLinkCount} 个站内正常链接 (稀释扣除 ${deduction} 分)`);
      }

      return { score: Math.max(0, score), reasons };
    }

    scan() {
      if (this.isScanning) return;
      this.isScanning = true;

      const elements = document.querySelectorAll('div, iframe, a, img, section, article, ins, [class*="ad"], [id*="ad"], [class*="overlay"], [class*="backdrop"], [id*="overlay"], [id*="backdrop"]');

      elements.forEach((el) => {
        if (this.isExcludedElement(el)) return;

        let adId = el.getAttribute('data-ad-detector-id');
        const existingMeta = adId ? this.detectedAds.get(adId) : null;

        const { score, reasons } = this.calculateAdScore(el);

        if (score >= 40 || (existingMeta && existingMeta.isBlocked)) {
          if (!adId) {
            this.counter++;
            adId = `ad-detected-${this.counter}`;
            el.setAttribute('data-ad-detector-id', adId);
          }

          const rect = el.getBoundingClientRect();
          const formattedSize = existingMeta ? existingMeta.size : `${Math.round(rect.width)}x${Math.round(rect.height)}px`;

          const anchor = el.tagName === 'A' ? el : el.querySelector('a[href]');
          let hrefHost = '';
          try {
            if (anchor && anchor.href) hrefHost = new URL(anchor.href, window.location.href).hostname;
          } catch (e) { }
          const fingerprint = `${el.tagName.toLowerCase()}_${formattedSize}_${hrefHost}`;

          const finalScore = existingMeta ? Math.max(existingMeta.score, score) : score;
          const finalReasons = (existingMeta && existingMeta.score > score) ? existingMeta.reasons : reasons;

          const meta = {
            id: adId,
            element: el,
            score: finalScore,
            reasons: finalReasons,
            tagName: el.tagName.toLowerCase(),
            size: formattedSize,
            classAndId: `${el.id ? '#' + el.id : ''}${el.className ? '.' + el.className : ''}`.trim(),
            fingerprint: fingerprint,
            isBlocked: existingMeta ? existingMeta.isBlocked : false
          };

          if (!meta.isBlocked && this.isMatchesBlockedRule(meta)) {
            meta.isBlocked = true;
            el.dataset.overlayBlocked = 'true';
            el.style.setProperty('display', 'none', 'important');
          }

          this.detectedAds.set(adId, meta);

          if (this.isHighlighted && !meta.isBlocked) {
            this.applyHighlight(el, true, formattedSize);
          }
        }
      });

      this.isScanning = false;
      if (this.isUIVisible) {
        this.updateUI();
      }
      return this.detectedAds;
    }

    initObserver() {
      this.observer = new MutationObserver((mutations) => {
        const isSelfMutation = mutations.every(m =>
          m.target.id === 'ad-detector-host' ||
          (m.target.classList && m.target.classList.contains('ad-detector-size-badge'))
        );
        if (isSelfMutation) return;

        if (this.scanTimer) clearTimeout(this.scanTimer);
        this.scanTimer = setTimeout(() => {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(() => this.scan(), { timeout: 1000 });
          } else {
            this.scan();
          }
        }, 350);
      });

      if (document.body) {
        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['style', 'class', 'src']
        });
      }

      this.scan();
    }

    toggleUI() {
      if (this.isUIVisible) {
        this.hideUI();
      } else {
        this.showUI();
      }
    }

    showUI() {
      if (this.isUIVisible && this.host && this.host.style.display !== 'none') return;
      this.isUIVisible = true;

      if (!this.host) {
        this.initUI();
      } else {
        this.host.style.display = 'block';
      }
      this.scan();

      this.saveUIVisibleState(true);
    }

    hideUI() {
      if (!this.isUIVisible) return;
      this.isUIVisible = false;
      if (this.host) {
        this.host.style.display = 'none';
      }

      this.saveUIVisibleState(false);
    }

