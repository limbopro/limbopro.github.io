    async neutralizeSingle(adId) {
      const meta = this.detectedAds.get(adId);


      if (!meta || meta.isBlocked) return;

      // 1. 显示顶部进度条
      const progress = this.showTopProgress();

      // 2. 给浏览器时间绘制进度条
      // 给浏览器两次绘制机会
      await new Promise(resolve => {
        requestAnimationFrame(() => {
          requestAnimationFrame(resolve);
        });
      });

      try {
        // 3. 记录历史状态
        this.pushHistoryState({
          type: 'SINGLE_BLOCK',
          items: [adId]
        });

        const el = meta.element;

        if (el && el.nodeType === Node.ELEMENT_NODE) {
          el.dataset.overlayBlocked = 'true';

          // 清理自身及子元素的高亮与 Hover 类
          el.classList.remove(
            'ad-detector-hover-active',
            'ad-detector-highlight-active'
          );
          el.style.removeProperty('outline');
          el.style.removeProperty('outline-offset');

          const activeChildren = el.querySelectorAll(
            '.ad-detector-hover-active, .ad-detector-highlight-active'
          );

          activeChildren.forEach(child => {
            child.classList.remove(
              'ad-detector-hover-active',
              'ad-detector-highlight-active'
            );
            child.style.removeProperty('outline');
            child.style.removeProperty('outline-offset');
          });

          // 清除角标与高亮图层
          this.applyHighlight(el, false);
        }

        // 4. 执行底层屏蔽逻辑
        this.neutralizeSingleInternal(adId);

        // 5. 反馈提示
        this.showToast('🛡 已通过安全交叉校验执行屏蔽');

        // 6. 更新 UI
        this.updateUI();

      } catch (error) {
        console.error('[AdDetector] 单节点屏蔽失败:', error);
        this.showToast('⚠️ 屏蔽操作执行异常，请检查控制台');
      } finally {
        // 7. 统一结束进度条
        progress.finish();
      }


    }




    restoreSingle(adId) {
      const meta = this.detectedAds.get(adId);
      if (meta && meta.isBlocked) {
        this.restoreSingleInternal(adId);
        this.pushHistoryState({ type: 'SINGLE_RESTORE', items: [adId] });
        this.showToast('↩️ 已撤销屏蔽，已更新本地规则库');

        // 补充：确保撤销屏蔽后面板列表同步还原状态
        this.updateUI();
      }
    }


