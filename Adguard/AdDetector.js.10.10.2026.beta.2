      newestBtn.addEventListener('click', () => {
        newestBtn.dataset.desc =
          newestBtn.dataset.desc === 'true' ? 'false' : 'true';
        newestBtn.textContent =
          newestBtn.dataset.desc === 'true' ? '最新在前' : '最早在前';
        render();
      });

      // 鼠标 / 触摸拖动悬浮按钮
      let pointerStartX = 0;
      let pointerStartY = 0;
      let fabStartX = 0;
      let fabStartY = 0;
      let dragging = false;
      let dragged = false;

      fab.addEventListener('pointerdown', event => {
        pointerStartX = event.clientX;
        pointerStartY = event.clientY;

        const rect = fab.getBoundingClientRect();
        fabStartX = rect.left;
        fabStartY = rect.top;

        dragging = true;
        dragged = false;

        try {
          fab.setPointerCapture(event.pointerId);
        } catch (e) { }

        event.preventDefault();
      });

      fab.addEventListener('pointermove', event => {
        if (!dragging) return;

        const dx = event.clientX - pointerStartX;
        const dy = event.clientY - pointerStartY;

        if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
          dragged = true;
        }
        if (!dragged) return;

        const maxX = window.innerWidth - fab.offsetWidth;
        const maxY = window.innerHeight - fab.offsetHeight;

        fab.style.left = Math.max(0, Math.min(maxX, fabStartX + dx)) + 'px';
        fab.style.top = Math.max(0, Math.min(maxY, fabStartY + dy)) + 'px';
        fab.style.right = 'auto';
        fab.style.bottom = 'auto';
      });

      function stopDragging() {
        if (!dragging) return;
        dragging = false;

        // 防止 pointerup 后 click 事件被当成点击
        if (dragged) {
          setTimeout(() => {
            dragged = false;
          }, 0);
        }
      }

      fab.addEventListener('pointerup', stopDragging);
      fab.addEventListener('pointercancel', stopDragging);

      render();
      console.info('[EventLogViewerV3] 悬浮日志面板已启动，共', data.length, '条记录');
    }

    showToast(message) {
      // 1. 获取或创建紧凑容器
      let container = document.getElementById('global-toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'global-toast-container';
        Object.assign(container.style, {
          position: 'fixed',
          top: '2px',
          left: '50%',
          transform: 'translateX(-50%)',
          zIndex: '2147483647',
          display: 'flex',
          flexDirection: 'column-reverse',
          alignItems: 'center',
          gap: '2px',
          pointerEvents: 'none',
          perspective: '1000px'
        });
        document.body.appendChild(container);
      }

      // 超过 4 条时移除最旧的一条
      if (container.children.length >= 4) {
        const oldestToast = container.firstElementChild;
        if (oldestToast) oldestToast.remove();
      }

      // 2. 遍历所有旧消息：尺寸与字体双重递减
      const existingToasts = Array.from(container.children);
      const totalExisting = existingToasts.length;

      existingToasts.forEach((oldToast, index) => {
        const distanceFromLatest = totalExisting - index;
        const newScale = Math.max(0.7, 1 - distanceFromLatest * 0.08);

        Object.assign(oldToast.style, {
          padding: '5px 12px',
          background: 'rgba(12, 12, 15, 0.85)',
          border: '1px solid rgba(255, 255, 255, 0.05)',
          boxShadow: '0 2px 8px rgba(0, 0, 0, 0.5)',
          fontSize: '11px', // 旧消息字体缩小，突显主次
          fontWeight: '400',
          transform: `scale(${newScale})`,
          transition: 'all 0.25s cubic-bezier(0.16, 1, 0.3, 1)',
          opacity: '1'
        });

        const badge = oldToast.querySelector('.toast-new-badge');
        if (badge) badge.remove();
      });

      // 3. 创建最新的 Toast 节点
      const toast = document.createElement('div');

      toast.innerHTML = `<span class="toast-new-badge" style="
    background: #0066FF;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    padding: 1px 6px;
    border-radius: 6px;
    margin-right: 6px;
    display: inline-block;
    vertical-align: middle;
    letter-spacing: 0.5px;
  ">NEW</span><span style="vertical-align: middle;">${message}</span>`;

      // 最新消息的暗黑高亮与大字号样式
      Object.assign(toast.style, {
        padding: '8px 18px',
        background: 'rgba(18, 18, 22, 0.95)',
        backdropFilter: 'blur(16px)',
        webkitBackdropFilter: 'blur(16px)',
        color: '#ECECF1',
        fontSize: '13.5px', // 字体加粗加大
        lineHeight: '1.4',
        fontWeight: '600',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        borderRadius: '14px',
        border: '1px solid rgba(0, 102, 255, 0.4)',
        boxShadow: '0 4px 16px rgba(0, 0, 0, 0.6), 0 0 10px rgba(0, 102, 255, 0.25)',

        /* 盒模型限制与换行逻辑 */
        boxSizing: 'border-box',
        maxWidth: 'min(85vw, 380px)',
        width: 'max-content',
        whiteSpace: 'normal',
        wordBreak: 'break-word',
        textAlign: 'center',

        opacity: '0',
        transform: 'translateY(-12px) scale(0.92)',
        transition: 'all 0.25s cubic-bezier(0.16, 1, 0.3, 1)',
        pointerEvents: 'auto',
        cursor: 'default',
        userSelect: 'none'
      });

      // 4. 挂载并触发动画
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.style.opacity = '1';
        toast.style.transform = 'translateY(0) scale(1)';
      });

      // 5. 自动清理
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(-10px) scale(0.9)';

        setTimeout(() => {
          toast.remove();
          if (container.children.length === 0) {
            container.remove();
          }
        }, 250);
      }, 3200);
    }


    bindInteractiveEvents() {
      const btnScan = this.shadow.querySelector('#btn-scan');
      const btnHl = this.shadow.querySelector('#btn-hl');
      const btnClean = this.shadow.querySelector('#btn-clean');
      const btnReset = this.shadow.querySelector('#btn-reset');
