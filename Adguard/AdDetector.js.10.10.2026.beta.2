      display: block !important;
    }

    .ad-detector-size-badge::before {
      content: attr(data-size);
    }
  `;
      (document.head || document.documentElement).appendChild(style);
    }

    bindGlobalHotkeys() {
      window.addEventListener('keydown', (e) => {
        if (e.altKey && (e.code === 'KeyA' || e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          this.toggleUI();
        }
      });
    }

    isExcludedElement(el) {
      if (!el) return true;

      // if (el.id === 'dh_pageContainer' || el.closest('#dh_pageContainer')) return true;
      if (el.id === 'dh_pageContainer' || (typeof el.closest === 'function' && el.closest('#dh_pageContainer'))) return true;

      // if (el.id === 'ad-detector-host' || el.closest('#ad-detector-host')) return true;
      // if (el.id === 'previewContainer' || el.closest('#previewContainer')) return true;
      // if (el.closest('a[href*="limbopro.com"]')) return true;

      if (el.id === 'ad-detector-host' || (typeof el.closest === 'function' && el.closest('#ad-detector-host'))) return true;
      if (el.id === 'previewContainer' || (typeof el.closest === 'function' && el.closest('#previewContainer'))) return true;
      if (typeof el.closest === 'function' && el.closest('a[href*="limbopro.com"]')) return true;

      const excludeRegex = /\b(limbo|notranslate)\b|limbo-/i;

      let curr = el;
      while (curr && curr !== document.documentElement) {
        const classAndId = `${curr.id || ''} ${curr.className || ''}`;
        if (excludeRegex.test(classAndId)) {
          return true;
        }
        curr = curr.parentElement;
      }

      return false;
    }

    isLegitimateElement(el) {
      if (!el || el === document.body || el === document.documentElement) return true;
      if (this.isExcludedElement(el)) return true;

      // ★【关键修复】：在安全校验前，优先提取透明度和定位样式
      // 如果是低透明度风险元素，拒绝一票否决，强制放行去 calculateAdScore 打分！
      const style = window.getComputedStyle(el);
      const opacityVal = parseFloat(style.opacity);
      const isLowOpacity = !isNaN(opacityVal) && opacityVal >= 0 && opacityVal <= 0.5;

      if (isLowOpacity) {
        return false; // 低透明度元素必须放行检测，不能直接判定为合法！
      }

      // 以下为常规非透明元素的保底放行逻辑
      if (el.querySelector('input, textarea, select, button, [role="dialog"], [aria-modal="true"]')) return true;
      const role = el.getAttribute('role');
      if (['main', 'navigation', 'search', 'dialog'].includes(role)) return true;

      return false;
    }


    getMainDomain(hostname) {
      if (!hostname) return '';
      const parts = hostname.split('.').filter(Boolean);
      if (parts.length <= 2) return hostname;
      return parts.slice(-2).join('.');
    }

    async isAnimatedGif(url) {
      if (!url) return false;
      if (this.animatedGifCache.has(url)) {
        return this.animatedGifCache.get(url);
      }

      // 1. 处理 Base64 格式
      if (url.startsWith('data:image/gif;base64,') || url.startsWith('data:image/base64,')) {
        try {
          const base64Data = url.split(',')[1];
          // 增加读取字节范围至 4096，提升多帧识别准确率
          const binaryString = atob(base64Data.slice(0, 4096));
          let frameCount = 0;
          for (let i = 0; i < binaryString.length - 2; i++) {
            // 匹配 Graphics Control Extension (0x21 0xF9) 或 Image Descriptor (0x2C)
            if (binaryString.charCodeAt(i) === 0x21 && binaryString.charCodeAt(i + 1) === 0xf9) {
              frameCount++;
              if (frameCount > 1) {
                this.animatedGifCache.set(url, true); // 多帧动态 GIF
                return true;
              }
            }
          }
          // 如果循环结束仅找到 <=1 帧，认定为单帧静态 GIF
          this.animatedGifCache.set(url, false);
          return false;
        } catch (e) {
          this.animatedGifCache.set(url, false);
          return false;
        }
      }

      // 2. 处理网络 URL 格式
      try {
        // 读取前 4096 字节
        const response = await fetch(url, { headers: { Range: 'bytes=0-4096' } });
        const buffer = await response.arrayBuffer();
        const bytes = new Uint8Array(buffer);

        const header = String.fromCharCode(...bytes.subarray(0, 6));
        if (!header.startsWith('GIF')) {
          this.animatedGifCache.set(url, false);
          return false;
        }

        let frameCount = 0;
        for (let i = 0; i < bytes.length - 2; i++) {
          if (bytes[i] === 0x21 && bytes[i + 1] === 0xf9) {
            frameCount++;
            if (frameCount > 1) {
              this.animatedGifCache.set(url, true); // 确认是多帧动图
              return true;
            }
          }
        }

        // 仅检测到单帧
        this.animatedGifCache.set(url, false);
        return false;
      } catch (e) {
        this.animatedGifCache.set(url, false);
        return false;
      }
    }

    calculateAdScore(el) {
      let score = 0;
      const reasons = [];

      if (this.isLegitimateElement(el)) return { score: 0, reasons: [] };

      // ★ 1. 优先判定是否已被手动标记屏蔽或匹配规则
      const isBlockedDataset = el.dataset && (el.dataset.overlayBlocked === 'true' || el.dataset.adBlockedXpath === 'true');
      const isSavedRule = this.isMatchesBlockedRule({
        element: el,
        classAndId: `${el.id ? '#' + el.id : ''}${el.className && typeof el.className === 'string' ? '.' + el.className : ''}`.trim(),
        fingerprint: `${el.tagName ? el.tagName.toLowerCase() : ''}_`
      });

      if (isBlockedDataset || isSavedRule) {
        const blockReason = isSavedRule ? '匹配历史持久化规则自动屏蔽' : '已被当前会话手动屏蔽';
        return {
          score: 40, // 强制赋予 40 分，确保稳定留在 scan 列表中
          reasons: [`${blockReason}（已置底/额外方式隐藏）[+40分]`]
        };
      }

      const style = window.getComputedStyle(el);
      const opacityVal = parseFloat(style.opacity);
      // 判断当前元素是否属于低透明度风险元素
      const isLowOpacity = !isNaN(opacityVal) && opacityVal >= 0 && opacityVal <= 0.5;

      // =============================================================
      // ★【优化 1】：识别合法社交分享/交互组件（白名单前置）
      // =============================================================
      const isSocialShareComponent = !!(
        el.querySelector?.('.social-share, .share-component, [class*="social-share"]') ||
        /(social-share|share-component|bshare|bdshare)/i.test(`${el.id || ''} ${el.className || ''}`)
      );

      // =============================================================
      // ★【修复点 1】：解锁 pointer-events: none 对低透明度元素的一票否决
      // =============================================================
      if (style.display === 'none' || style.visibility === 'hidden') {
        return { score: 0, reasons: [] };
      }

      // 如果设置了 pointer-events: none，但不是低透明度元素，才剪枝；如果是低透明度元素，放行检测！
      if (style.pointerEvents === 'none' && !isLowOpacity) {
        return { score: 0, reasons: [] };
      }

      // =============================================================
      // ★【修复点 2】：放宽尺寸限制，防止 0 尺寸低透明遮罩被提前 Exit
      // =============================================================
      const rect = el.getBoundingClientRect();
      if (rect.width === 0 && rect.height === 0 && !isLowOpacity) {
        return { score: 0, reasons: [] };
      }

      const vw = window.innerWidth || document.documentElement.clientWidth;
      const vh = window.innerHeight || document.documentElement.clientHeight;
      const viewportArea = vw * vh;

      // -------------------------------------------------------------
      // ★【重构】透明点击劫持与网格遮罩检测 (Anti-Clickjacking Module)
      // -------------------------------------------------------------
      const isPositioned1 = style.position === 'fixed' || style.position === 'absolute';

      if (isLowOpacity) {
        let addedScore = 0;
        let riskLabel = '';

        // -------------------------------------------------------------
        // ★【新增防护】：识别常见 UI 提示/通知组件，并检查是否具备交互能力
        // -------------------------------------------------------------
        const isNotificationUI = /(toast|tooltip|message|notice|alert|notification|snackbar)/i.test(`${el.id || ''} ${el.className || ''}`);
        const hasClickableElements = !!(el.querySelector && el.querySelector('a[href], button, input, select, textarea, iframe, [onclick]'));

        // 如果是合法的社交分享组件，动画过程中的透明度变化不视为点击劫持
        if (isSocialShareComponent) {
          addedScore = 0;
          riskLabel = '合法社交分享组件(忽略透明度风险)';
        } else if (isPositioned1 && opacityVal <= 0.1) {
          // ★【保持原本规则】：若为无交互能力的 Toast/UI 提示节点，降级为低危（15分）
          if (isNotificationUI && !hasClickableElements) {
            addedScore = 15;
            riskLabel = `无交互 UI 提示组件/Toast (fixed/absolute + Opacity: ${opacityVal.toFixed(2)})`;
          } else {
            // 高危组合：直接赋予 55 分
            addedScore = 55;
            riskLabel = `透明点击劫持 (fixed/absolute + Opacity: ${opacityVal.toFixed(2)})`;
          }
        } else if (isPositioned1) {
          // 中危组合：定位 + 普通低透明度，给 30 分
          addedScore = 30;
          riskLabel = `定位低透明度元素 (fixed/absolute + Opacity: ${opacityVal.toFixed(2)})`;
        } else {
          // 低危组合：普通文档流低透明，给 15 分
          addedScore = 15;
          riskLabel = `透明度异常低 (Opacity: ${opacityVal.toFixed(2)})`;
        }

        // 尺寸校验：宽高均等于 0，扣除 15 分降级
        if (!isSocialShareComponent && rect.width === 0 && rect.height === 0) {
          addedScore -= 15;
          riskLabel += ' [宽高均为0, 扣除15分]';
        }

        // 防负分截断
        addedScore = Math.max(0, addedScore);

        // 结果结算
        if (addedScore > 0) {
          score += addedScore;
          reasons.push(`${riskLabel} [+${addedScore}分]`);
        } else if (riskLabel) {
          reasons.push(`${riskLabel} [+0分]`);
        }

        // =================【写入 localStorage 日志】=================
        try {
          const parent = el.parentElement;
          const index = parent ? Array.from(parent.children).indexOf(el) : 0;
          const elSelector = `${el.tagName.toLowerCase()}${el.id ? '#' + el.id : ''}${el.className && typeof el.className === 'string' ? '.' + el.className.trim().replace(/\s+/g, '.') : ''}:nth-child(${index + 1})`;

          const storageKey = 'ad_detector_low_opacity_logs';
          const existingLogs = JSON.parse(localStorage.getItem(storageKey) || '[]');

          const elPosition = `${style.bottom}_${style.left}_${style.zIndex}`;
          const isDuplicate = existingLogs.some(item => item.selector === elSelector && item.pos === elPosition);

          if (!isDuplicate) {
            existingLogs.push({
              selector: elSelector,
              opacity: opacityVal,
              score: score,
              pos: elPosition,
              style: el.getAttribute('style') || '',
              text: (el.textContent || '').trim().slice(0, 50),
              html: el.outerHTML.slice(0, 150),
              time: new Date().toLocaleTimeString()
            });

            if (existingLogs.length > 50) existingLogs.shift();

            localStorage.setItem(storageKey, JSON.stringify(existingLogs));
          }
        } catch (err) {
          // 静默兜底
        }
      }

      // 透明度积分项结束

      const originHost = window.location.hostname;
      const currentMainDomain = this.getMainDomain(originHost);

      const allAnchors = Array.from(el.querySelectorAll('a[href]'));
      let sameDomainLinkCount = 0;
      let crossDomainLinkCount = 0;

      allAnchors.forEach(a => {
        try {
          const u = new URL(a.href, window.location.href);
          if (this.getMainDomain(u.hostname) === currentMainDomain && !u.protocol.startsWith('javascript')) {
            sameDomainLinkCount++;
          } else {
            crossDomainLinkCount++;
          }
        } catch (e) { }
      });

      // =============================================================
      // ★【保护项】：避免低透明度元素被“容器内有2个站内链接”一票否决
      // =============================================================
      if (sameDomainLinkCount >= 2 && !isLowOpacity) {
        return { score: 0, reasons: ['容器内包含多个站内正常链接，豁免判定为合法内容板块 [+0分]'] };
      }

      // ★【优化 2】：精准化广告词库
      const adWordRegex = /(^|[-_ \/])(ad|ads|advert|advertising|advertisement|banner|backdrop|sponsor|sponsored|promoted|promo|guanggao|gg|floatad|float-ad|couplet|duilian|billboard|paster|sticky-ad|recommend-ad|right-ad|top-ad|bottom-ad|side-ad)([-_ \/]|s?$)/i;
      const selfOrAntiAdRegex = /(^|[-_ \/])(ad-detector|anti-ad|anti-adblock|adblock-warning|ad-blocker)([-_ \/]|$)/i;

      const classAndId = `${el.id || ''} ${el.className || ''}`;

      const isSelfOrAntiAd = selfOrAntiAdRegex.test(classAndId);

      if (!isSocialShareComponent && !isSelfOrAntiAd && adWordRegex.test(classAndId)) {
        score += 35;
        reasons.push('Class/ID 命中广告关键词 [+35分]');
      }

      const areaRatio = (rect.width * rect.height) / (viewportArea || 1);
      const isPositioned = style.position === 'fixed' || style.position === 'absolute';
      const zIndex = parseInt(style.zIndex, 10) || 0;

      const iabSizes = [[728, 90], [300, 250], [336, 280], [160, 600], [300, 600], [970, 90], [320, 50]];
      const isIABSize = iabSizes.some(([w, h]) => Math.abs(rect.width - w) <= 6 && Math.abs(rect.height - h) <= 6);
      if (isIABSize) {
        score += 30;
        reasons.push('符合 IAB 标准广告尺寸 [+30分]');
      }

      if ((style.position === 'fixed' || style.position === 'sticky') && zIndex > 50) {
        if (rect.height < 260 && (rect.top <= 10 || rect.bottom >= vh - 10)) {
          score += 30;
          reasons.push('顶/底悬浮贴片弹窗 [+30分]');
        }
      }

      const imgEl = el.tagName === 'IMG' ? el : el.querySelector('img');
      if (imgEl) {
        const imgSrc = imgEl.currentSrc ||
          imgEl.src ||
          imgEl.getAttribute('data-src') ||
          imgEl.getAttribute('data-original') || '';

        const imgAlt = imgEl.getAttribute('alt') || '';

        const isBase64Gif = /^data:image\/gif/i.test(imgSrc) ||
          (imgSrc.startsWith('data:image/') && imgSrc.includes('base64,') && imgSrc.includes('R0lGODlh'));
        const isNetGif = /\.gif($|\?)/i.test(imgSrc) || imgSrc.includes('format=gif');

        if (/(广告|横幅|推广|赞助|sponsor|promoted|banner|ad)/i.test(imgAlt)) {
          score += 40;
          reasons.push(`图片 Alt 属性命中广告描述 ("${imgAlt}") [+40分]`);
        }

        if (/\/promo\/|\/ad[s_]?\d*|\/advert/i.test(imgSrc)) {
          score += 35;
          reasons.push('图片链接路径包含广告/推广目录 (/promo/或/ad_) [+35分]');
        }

        if (isBase64Gif || isNetGif) {
          if (isBase64Gif) {
            score += 35;
            reasons.push('使用 Base64 Data-URI 格式内嵌 GIF [+35分]');

            if (imgSrc.includes('R0lGODlh')) {
              score += 10;
              reasons.push('匹配标准 GIF Base64 编码头部 [+10分]');
            }
          }

          if (isNetGif && /ad|banner|union|pop|sp|delivery|gg|float/i.test(imgSrc)) {
            score += 30;
            reasons.push('GIF 路径包含广告/网盟关键字 [+30分]');
          }

          const cacheResult = this.animatedGifCache.get(imgSrc);
          if (cacheResult === true) {
            score += 25;
            reasons.push('检测到多帧动态 GIF (High Attention) [+25分]');
          } else if (cacheResult === false) {
            reasons.push('判定为单帧/静态 GIF (低吸引力) [+0分]');
          } else if (cacheResult === undefined) {
            this.animatedGifCache.set(imgSrc, 'PENDING');

            this.isAnimatedGif(imgSrc).then((isAnim) => {
              this.animatedGifCache.set(imgSrc, isAnim);
              this.scan();
            }).catch(() => {
              this.animatedGifCache.set(imgSrc, false);
            });
          }
        }
      }

      const badgeEl = el.querySelector('span, div, em, i');
      if (badgeEl) {
        const badgeText = (badgeEl.textContent || '').trim();
        if (/^(AD|广告|赞助|推广)$/i.test(badgeText)) {
          score += 45;
          reasons.push(`匹配到独立的角标文本 ("${badgeText}") [+45分]`);
        }
      }

      if (el.tagName === 'IFRAME') {
        const src = el.src || '';
        let matchedSpecificRule = false;

        if (src && !src.startsWith(window.location.origin) && !src.startsWith('about:')) {
          score += 25;
          reasons.push('跨域 iframe 嵌套 [+25分]');
          matchedSpecificRule = true;
        }

        if (/pos|slot|pagead|doubleclick|union|ssp|popunder|m3u8|embed/i.test(src)) {
          score += 35;
          reasons.push('匹配网盟或可疑外链 iframe [+35分]');
          matchedSpecificRule = true;
        }

        if (!matchedSpecificRule) {
          score += 40;
          reasons.push('默认 iframe 基础风险分 [+40分]');
        }
      }

      const LEGITIMATE_PREFIX_REGEX = /^(el|ant|ion|mat|ng|van|sl|mwc|p|pwa|next|nuxt|sw)-/i;

      if (el.shadowRoot || (el.tagName && el.tagName.includes('-'))) {
        const tagName = el.tagName.toLowerCase();
        const role = el.getAttribute('role');

        const isLegitimate = LEGITIMATE_PREFIX_REGEX.test(tagName) ||
          ['navigation', 'main', 'button', 'search', 'dialog', 'banner'].includes(role);

        if (!isLegitimate) {
          score += 40;
          reasons.push(`检测到可疑 Shadow DOM / 自定义隔离节点 (<${tagName}>) [+40分]`);
        }
      }

      if (el instanceof HTMLElement) {
        const isContainer = /^(DIV|SECTION|ARTICLE|ASIDE|HEADER|FOOTER|MAIN|NAV|FORM|TABLE|IFRAME)$/i.test(el.tagName) || el.shadowRoot;

        if (isContainer) {
          const position = style.position;

          if (position === 'fixed' || position === 'sticky') {
            const parsedZIndex = parseInt(style.zIndex, 10);
            const zIndex = isNaN(parsedZIndex) ? 0 : parsedZIndex;

            if (zIndex >= 50 || (position === 'fixed' && style.zIndex === 'auto')) {
              const role = el.getAttribute('role');
              const isNavigation = ['navigation', 'main', 'search', 'banner', 'dialog'].includes(role) ||
                ['NAV', 'HEADER', 'FOOTER', 'SEARCH'].includes(el.tagName);

              const hasInteractiveElements = !!el.querySelector('input, textarea, select, button, a[href]');
              const isFullViewportShell = rect.width >= window.innerWidth && rect.height >= window.innerHeight && !style.backgroundColor;

              // ★【补丁修复 1】：识别微型悬浮挂载容器（如 390x1px 的 positionFooter）
              const isMicroContainer = (rect.height > 0 && rect.height <= 5) || (rect.width > 0 && rect.width <= 5);

              if (isMicroContainer) {
                score += 45;
                reasons.push(`高风险微型悬浮挂载容器 (${position}, z-index: ${style.zIndex}, 尺寸: ${Math.round(rect.width)}x${Math.round(rect.height)}px) [+45分]`);
              }
              // ★【常规容器校验】
              else if (zIndex >= 99 && !isNavigation && !hasInteractiveElements && !isFullViewportShell) {
                score += 40;
                reasons.push(`高风险悬浮/黏性容器 (${position}, z-index: ${style.zIndex}) [+40分]`);
              }
            }
          }
        }
      }

      const scriptText = el.querySelector('script')?.textContent || '';
      if (scriptText.includes('opacity:0') || (scriptText.includes('touchend') && scriptText.includes('location.href'))) {
        if (scriptText.includes('new Function') || scriptText.includes('eval') || scriptText.includes('document.write')) {
          score += 50;
          reasons.push('容器内包含低透明度动态注入的混淆脚本 [+50分]');
        }
      }

      // ★【优化 3】：新增知名合法社交/服务域名白名单
      const KNOWN_SOCIAL_DOMAINS = [
        // --- 国内平台 ---
        'weibo.com', 'weibo.cn',
        'qq.com', 'qzone.qq.com', 'weixin.qq.com', 'mp.weixin.qq.com',
        'douban.com', 'zhihu.com', 'tieba.baidu.com',
        'xiaohongshu.com', 'bilibili.com', 'douyin.com', 'kuaishou.com',
        'gitee.com',

        // --- 国外平台 ---
        'line.me', 'timeline.line.me',
        'twitter.com', 'x.com',
        'facebook.com', 'instagram.com', 'threads.net', 'pinterest.com',
        'linkedin.com', 'reddit.com', 'tumblr.com', 'flickr.com',
        'youtube.com', 'youtu.be', 'tiktok.com', 'vimeo.com',
        't.me', 'telegram.org', 'whatsapp.com', 'discord.com', 'discord.gg',
        'github.com', 'medium.com'
      ];

      const anchor = el.tagName === 'A' ? el : (allAnchors[0] || null);
      if (anchor) {
        const rawHref = anchor.getAttribute('href') || '';

        let isKnownSocialLink = false;
        try {
          const targetUrl = new URL(anchor.href, window.location.href);
          isKnownSocialLink = KNOWN_SOCIAL_DOMAINS.some(domain => targetUrl.hostname.includes(domain));
        } catch (e) { }

        // 只有当非知名社交平台链接时，才进行重定向检测
        if (!isKnownSocialLink) {
          const suspiciousRedirectRegex = /(\/|\?)(go|goto|redirect|out|click|jump|target|url|link|visit)(\/|\?|=|_)/i;
          if (suspiciousRedirectRegex.test(rawHref)) {
            score += 35;
            reasons.push(`命中站内重定向/广告跳转路径 ("${rawHref.slice(0, 30)}...") [+35分]`);
          }

          if (/\/go\/[A-Za-z0-9%_\-~]{20,}/i.test(rawHref)) {
            score += 25;
            reasons.push('检测到长串 Base64 加密型广告跳转链接 [+25分]');
          }

          if (rawHref === '#' || rawHref.startsWith('javascript:')) {
            if (isPositioned && areaRatio > 0.05) {
              score += 50;
              reasons.push('透明/伪装点击劫持 (JS/空链接) [+50分]');
            }
          }

          const redirectPattern = /(\/|\?)(goto|redirect|out|click|jump|target=|\?url=|\&url=)/i;
          if (redirectPattern.test(rawHref)) {
            score += 30;
            reasons.push('站内隐蔽重定向跳转链接 [+30分]');
          }
        }

        try {
          const targetUrl = new URL(anchor.href, window.location.href);
          const targetMainDomain = this.getMainDomain(targetUrl.hostname);

          if (targetMainDomain && targetMainDomain !== currentMainDomain && !targetUrl.protocol.startsWith('javascript')) {
            let linkScore = 35;
            let linkDetails = ['基础跨域 [+35分]'];

            if (anchor.target === '_blank') {
              linkScore += 15;
              linkDetails.push('新标签页打开 [+15分]');
            }

            const img = anchor.querySelector('img');
            if (img) {
              linkScore += 10;
              const imgSrc = img.getAttribute('src') || '';
              if (imgSrc.startsWith('data:image/') || /\.gif($|\?)/i.test(imgSrc)) {
                linkDetails.push('GIF/Base64 动图跳转 [+10分]');
              } else {
                linkDetails.push('图片占位 [+10分]');
              }
            }

            if (el.tagName !== 'A') {
              if (sameDomainLinkCount > 0) {
                const oldScore = linkScore;
                linkScore = Math.floor(linkScore * 0.2);
                linkDetails.push(`父容器含正常链接 (削减至20%, -${oldScore - linkScore}分)`);
              } else if (el.childElementCount > 3) {
                const oldScore = linkScore;
                linkScore = Math.floor(linkScore * 0.5);
                linkDetails.push(`父节点多元素 (权重减半, -${oldScore - linkScore}分)`);
              }
            }

            // ★ 已知社交平台链接降权
            if (isKnownSocialLink) {
              const oldScore = linkScore;
              linkScore = Math.floor(linkScore * 0.1);
              linkDetails.push(`知名社交链接豁免 (削减至10%, -${oldScore - linkScore}分)`);
            }

            if (linkScore > 0) {
              score += linkScore;
              reasons.push(`跨域外链 (${targetUrl.hostname}) [包含: ${linkDetails.join(', ')} → 最终加 ${linkScore} 分]`);
            }
          }
        } catch (e) { }

        const textContent = (anchor.textContent || '').trim();
        if (textContent) {
          const highRiskRegex = /(裸聊|菠菜|博彩|荷官|约炮|黄播|六合|反波胆|爆率|必中|挂机|刷单|🈲|🔞)/i;
          const mediumRiskRegex = /(免费看|激情|性感|棋牌|投注|充值|特惠|点击看|加微信|私聊|App下载|点击播放|同城|福利|兼职|日赚|提现|领红包|免费领|加薇|加V|Vx|v信)/i;

          let wordScore = 0;
          let matchedWord = '';

          if (highRiskRegex.test(textContent)) {
            wordScore = 35;
            matchedWord = textContent.match(highRiskRegex)[0];
          } else if (mediumRiskRegex.test(textContent)) {
            wordScore = 15;
            matchedWord = textContent.match(mediumRiskRegex)[0];
          }

          if (wordScore > 0) {
            let reasonNote = `[+${wordScore}分]`;
            if (el.tagName !== 'A' && sameDomainLinkCount > 0) {
              const oldWordScore = wordScore;
              wordScore = Math.floor(wordScore * 0.3);
              reasonNote = `[原始+${oldWordScore}分 → 父容器有正规链接打折后: +${wordScore}分]`;
            }
            score += wordScore;
            reasons.push(`命中诱导敏感词 ("${matchedWord}") ${reasonNote}`);
          }
        }
      }

      // 防误杀：如果不是低透明度元素，才对多域名链接做稀释扣分
      if (sameDomainLinkCount > 0 && crossDomainLinkCount > 0 && !isLowOpacity) {
        const totalLinks = sameDomainLinkCount + crossDomainLinkCount;
        const normalRatio = sameDomainLinkCount / totalLinks;
        const deduction = Math.floor(score * normalRatio);
        score -= deduction;
        reasons.push(`混有 ${sameDomainLinkCount} 个站内正常链接 (稀释扣除 -${deduction}分)`);
      }

      return { score: Math.max(0, score), reasons };
    }



    // ==========================================
    // ★ 高性能重构模块：全量选择器 + 绝对读写隔离 + 极速剪枝
    // ==========================================
    scan() {
      if (this.isScanning) return this.detectedAds;
      this.isScanning = true;

      // 初始化节点评估缓存（若类构造函数中未定义，可单例创建）
      if (!this.evaluatedNodes) {
        this.evaluatedNodes = new WeakSet();
      }

      // 1. 节点存活度与有效性自检（清理已从 DOM 卸载的无效记录）
      for (const [adId, meta] of this.detectedAds.entries()) {
        if (!meta.element || !document.contains(meta.element)) {
          this.detectedAds.delete(adId);
        }
      }

      // 2. 多源收集候选节点（原封不动保留你的全量 Selector 与 Shadow DOM 递归）
      const candidateNodes = new Set();
      const collectCandidatesFromRoot = (root) => {
        if (!root) return;

        // 彻底保留你原有的完整全量选择器
        const selector = [
          'div', 'iframe', 'a', 'img', 'section', 'article', 'ins', 'aside', 'header', 'footer', 'canvas', 'video', 'embed', 'object',
          '[class*="ad"]', '[id*="ad"]', '[class*="overlay"]', '[class*="backdrop"]', '[id*="overlay"]', '[id*="backdrop"]',
          '[class*="popup"]', '[id*="popup"]', '[class*="modal"]', '[id*="modal"]', '[class*="sponsor"]', '[id*="sponsor"]'
        ].join(', ');

        const elements = root.querySelectorAll(selector);
        for (let i = 0; i < elements.length; i++) {
          const el = elements[i];
          candidateNodes.add(el);
          // 深度穿透开放的 Shadow DOM 节点
          if (el.shadowRoot) {
            collectCandidatesFromRoot(el.shadowRoot);
          }
        }
      };

      collectCandidatesFromRoot(document);

      // 用于读写分离的临时队列
      const updatesToApply = [];

      // 3. 【第一阶段：纯读取与极速过滤 (READ PHASE)】
      // 绝对禁止在此循环内修改任何 DOM（不设置 attribute，不改 style）
      candidateNodes.forEach((el) => {
        if (this.isExcludedElement(el)) return;

        let adId = el.getAttribute('data-ad-detector-id');
        const existingMeta = adId ? this.detectedAds.get(adId) : null;

        // 优化点：若节点已被标记屏蔽且内存中已记录状态，直接跳过后续重新写入 DOM 的操作
        if (existingMeta && existingMeta.isBlocked && el.dataset.overlayBlocked === 'true') {
          return;
        }

        // 【剪枝 1】：非广告且已评估过的节点，直接跳过
        if (!existingMeta && this.evaluatedNodes.has(el)) return;

        // 【剪枝 2】：如果是已被屏蔽的节点（带标记或匹配持久化规则），允许放行；仅对未屏蔽且未渲染的纯隐形节点进行剪枝
        const isAlreadyBlocked = (el.dataset && (el.dataset.overlayBlocked === 'true' || el.dataset.adBlockedXpath === 'true')) || this.isMatchesBlockedRule({ element: el });

        ////if (!isAlreadyBlocked) {
        // 未屏蔽的节点，如果完全不可见/无尺寸则剪枝
        ////if (el.offsetWidth === 0 && el.offsetHeight === 0) return;
        ////}

        // 修改后：
        if (!isAlreadyBlocked) {
          // 即使 offsetWidth/offsetHeight 为 0，如果是 fixed/absolute 定位或带透明度，也不要直接剪枝
          const style = window.getComputedStyle(el);
          const opacityVal = parseFloat(style.opacity);
          const isTransparent = !isNaN(opacityVal) && opacityVal <= 0.5;
          const isFloating = style.position === 'fixed' || style.position === 'absolute';

          if (el.offsetWidth === 0 && el.offsetHeight === 0 && !isTransparent && !isFloating) {
            return;
          }
        }

        // 【剪枝 3】：对大量无特征的普通文本/容器节点实施毫秒级快速放行
        // 注意：必须排除带有低透明度/悬浮定位的高危隐藏节点！
        if (!existingMeta && (el.tagName === 'DIV' || el.tagName === 'SECTION' || el.tagName === 'ARTICLE')) {
          if (!el.id && !el.className && !el.querySelector('a[href]')) {

            // ★【关键修复】：在剪枝前，先校验它是否为隐蔽/透明节点
            const style = window.getComputedStyle(el);
            const opacityVal = parseFloat(style.opacity);
            const isLowOpacity = !isNaN(opacityVal) && opacityVal <= 0.5;
            const isFloating = style.position === 'fixed' || style.position === 'absolute';

            // 如果既没有 Class/ID/链接，又是正常的非透明/非悬浮元素，才进行快速剪枝
            if (!isLowOpacity && !isFloating) {
              this.evaluatedNodes.add(el);
              return;
            }
            // 如果是透明或悬浮的无 Class/ID 节点，放行进入后续的 calculateAdScore 打分！
          }
        }


        // 执行算法判别与打分
        const { score, reasons } = this.calculateAdScore(el);

        if (score >= 40 || (existingMeta && existingMeta.isBlocked)) {
          // 读取节点布局与链接属性（仅 Read，不 Write）
          const rect = el.getBoundingClientRect();
          const formattedSize = existingMeta ? existingMeta.size : `${Math.round(rect.width)}x${Math.round(rect.height)}px`;

          const anchor = el.tagName === 'A' ? el : el.querySelector('a[href]');
          let hrefHost = '';
          try {
            if (anchor && anchor.href) hrefHost = new URL(anchor.href, window.location.href).hostname;
          } catch (e) { }

          const fingerprint = `${el.tagName.toLowerCase()}_${formattedSize}_${hrefHost}`;
          const finalScore = existingMeta ? Math.max(existingMeta.score, score) : score;
          const finalReasons = (existingMeta && existingMeta.score > score) ? existingMeta.reasons : reasons;

          // 暂存计算好的数据，推迟到 Write 阶段统一处理
          updatesToApply.push({
            el,
            adId,
            existingMeta,
            score: finalScore,
            reasons: finalReasons,
            formattedSize,
            fingerprint
          });
        } else {
          // 记录为普通节点，下一次扫描无需重复打分
          this.evaluatedNodes.add(el);
        }
      });

      // 4. 【第二阶段：批量统一写入 DOM (WRITE PHASE)】
      // 将所有对 DOM 的写操作集中在一起处理，强制浏览器仅触发 1 次重排
      if (updatesToApply.length > 0) {
        updatesToApply.forEach(({ el, adId, existingMeta, score, reasons, formattedSize, fingerprint }) => {
          if (!adId) {
            this.counter++;
            adId = `ad-detected-${this.counter}`;
            el.setAttribute('data-ad-detector-id', adId);
          }

          const meta = {
            id: adId,
            element: el,
            score: score,
            reasons: reasons,
            tagName: el.tagName.toLowerCase(),
            size: formattedSize,
            classAndId: `${el.id ? '#' + el.id : ''}${el.className && typeof el.className === 'string' ? '.' + el.className : ''}`.trim(),
            fingerprint: fingerprint,
            isBlocked: existingMeta ? existingMeta.isBlocked : false
          };

          if (!meta.isBlocked && this.isMatchesBlockedRule(meta)) {
            meta.isBlocked = true;
            el.dataset.overlayBlocked = 'true';
            // el.style.setProperty('display', 'none', 'important');
            this.hideSingleElement(el)

          }

          this.detectedAds.set(adId, meta);

          if (this.isHighlighted && !meta.isBlocked) {
            this.applyHighlight(el, true, formattedSize);
          }
        });
      }

      this.isScanning = false;
      if (this.isUIVisible) {
        this.updateUI();
      }
      return this.detectedAds;
    }


    // ==========================================
    // 优化后的 MutationObserver 及锁机制
    // ==========================================

    initObserver() {
      let scanScheduled = false;

      this.observer = new MutationObserver((mutations) => {
        let hasExternalMutation = false;
        const targetsToScan = new Set();

        for (let i = 0; i < mutations.length; i++) {
          const m = mutations[i];
          const target = m.target;

          // 1. 过滤内部节点修改及已被屏蔽的节点，彻底切断死循环
          if (
            target.id === 'ad-detector-host' ||
            target.id === 'ad-detector-dynamic-css-rules' ||
            (target.classList && typeof target.classList.contains === 'function' && target.classList.contains('ad-detector-size-badge')) ||
            (target.dataset && (target.dataset.overlayBlocked === 'true' || target.dataset.adBlockedXpath === 'true')) // 增加对 XPath 已屏蔽节点的过滤
          ) {
            continue;
          }

          hasExternalMutation = true;

          // 2. 收集增量添加的节点（优先采用增量检查）
          if (m.type === 'childList' && m.addedNodes.length > 0) {
            m.addedNodes.forEach(node => {
              if (node.nodeType === Node.ELEMENT_NODE) {
                targetsToScan.add(node);
              }
            });
          }
        }

        if (!hasExternalMutation) return;

        // 3. 节流与防抖合并（空闲调度）
        if (!scanScheduled) {
          scanScheduled = true;
          const scheduleTask = window.requestIdleCallback || ((cb) => setTimeout(cb, 200));

          scheduleTask(() => {
            // 如果新增节点较少，仅对新增节点（及其子树）增量排查与 XPath 履约；若过多则降级为全局扫描
            if (targetsToScan.size > 0 && targetsToScan.size < 20) {
              // 执行原有的启发式增量扫描
              this.scanIncremental(targetsToScan);
              // 对新增的这批节点及其子树单独履行 XPath 规则
              this.applyXPathsIncremental(targetsToScan);
            } else {
              // 触发全局启发式扫描 + 全局 XPath 履约
              this.scan();
              this.applyXPaths(document);
            }
            scanScheduled = false;
          }, { timeout: 1000 });
        }
      });

      if (document.body) {
        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['src'] // 保持优化：移除 style 和 class 的深度监听
        });
      }

      // 页面首次初始化执行
      this.scan();
      this.applyXPaths(document);

      // 增加：页面初始化及每次 MutationObserver 监听到新节点时，立即进行规则比对与状态锁死
      this.applySavedRulesToDOM();
      this.scan();

    }

    applySavedRulesToDOM() {
      if (!Array.isArray(this.blockedRules)) return;
      this.blockedRules.forEach((rule) => {
        let selector = rule.selector;
        if (selector) {
          try {
            document.querySelectorAll(selector).forEach((el) => {
              el.dataset.overlayBlocked = 'true';
              // el.style.setProperty('display', 'none', 'important');
              this.hideSingleElement(el)
            });
          } catch (e) { }
        }
      });
    }


    /**
     * 【修复版】针对全盘或特定根节点匹配并执行隐藏 XPath 规则
     */
    applyXPaths(rootNode = document) {
      if (!this.blockedXPaths || this.blockedXPaths.length === 0) return;

      this.blockedXPaths.forEach(xpathStr => {
        try {
          // evaluate 上下文如果是普通 Element，遇到以 / 开头的绝对路径 XPath 会报错或失效
          // 因此对于绝对路径，上下文统一回退至 document
          const contextNode = (xpathStr.startsWith('/') && rootNode !== document)
            ? document
            : rootNode;

          const result = document.evaluate(
            xpathStr,
            contextNode,
            null,
            XPathResult.ORDERED_NODE_SNAPSHOT_TYPE,
            null
          );

          for (let i = 0; i < result.snapshotLength; i++) {
            const el = result.snapshotItem(i);
            if (el && el.nodeType === Node.ELEMENT_NODE && !el.dataset.adBlockedXpath) {
              // el.style.setProperty('display', 'none', 'important');
              this.hideSingleElement(el)
              el.dataset.adBlockedXpath = 'true';
              el.dataset.overlayBlocked = 'true'; // 保持逻辑一致性
            }
          }
        } catch (e) {
          console.warn('[XPath Engine] 执行表达式失败:', xpathStr, e);
        }
      });
    }

    /**
     * 【修复版】仅对增量变更的节点集及其子树履行 XPath 检查
     */
    applyXPathsIncremental(targetsSet) {
      if (!this.blockedXPaths || this.blockedXPaths.length === 0) return;

      targetsSet.forEach(targetNode => {
        if (targetNode.nodeType === Node.ELEMENT_NODE) {
          // 如果 targetNode 自身或者其子节点匹配了 XPath，执行隐藏
          this.applyXPaths(targetNode);
        }
      });
    }



    // ==========================================
    // 新增：高效增量节点扫描机制
    // ==========================================
    scanIncremental(nodes) {
      if (this.isScanning) return;

      nodes.forEach(node => {
        if (this.isExcludedElement(node)) return;

        // 如果节点本身是候选者
        const candidateSelector = 'div, iframe, a, img, section, ins, [class*="ad"], [id*="ad"]';
        if (node.matches && node.matches(candidateSelector)) {
          this.evaluateAndRegisterElement(node);
        }

        // 处理子节点
        if (node.querySelectorAll) {
          const children = node.querySelectorAll(candidateSelector);
          children.forEach(child => this.evaluateAndRegisterElement(child));
        }
      });

      if (this.isUIVisible) {
        this.updateUI();
      }
    }

    // 把单节点评估与注册提炼为独立轻量函数
    evaluateAndRegisterElement(el) {
      if (this.isExcludedElement(el)) return;

      let adId = el.getAttribute('data-ad-detector-id');
      const existingMeta = adId ? this.detectedAds.get(adId) : null;

      // 打分前优先进行快速不合规排查（避开计算重排属性）
      const { score, reasons } = this.calculateAdScore(el);

      if (score >= 40 || (existingMeta && existingMeta.isBlocked)) {
        if (!adId) {
          this.counter++;
          adId = `ad-detected-${this.counter}`;
          el.setAttribute('data-ad-detector-id', adId);
        }

        const formattedSize = existingMeta ? existingMeta.size : `${el.offsetWidth || 0}x${el.offsetHeight || 0}px`;
        const fingerprint = `${el.tagName.toLowerCase()}_${formattedSize}_`;

        const meta = {
          id: adId,
          element: el,
          score: existingMeta ? Math.max(existingMeta.score, score) : score,
          reasons: existingMeta && existingMeta.score > score ? existingMeta.reasons : reasons,
          tagName: el.tagName.toLowerCase(),
          size: formattedSize,
          classAndId: `${el.id ? '#' + el.id : ''}${el.className && typeof el.className === 'string' ? '.' + el.className : ''}`.trim(),
          fingerprint: fingerprint,
          isBlocked: existingMeta ? existingMeta.isBlocked : false
        };

        if (!meta.isBlocked && this.isMatchesBlockedRule(meta)) {
          meta.isBlocked = true;
          el.dataset.overlayBlocked = 'true';
          // el.style.setProperty('display', 'none', 'important');
          this.hideSingleElement(el)
        }

        this.detectedAds.set(adId, meta);
      }
    }


    toggleUI() {
      if (this.isUIVisible) {
        this.hideUI();
      } else {
        this.showUI();
      }
    }

    showUI() {
      if (this.isUIVisible && this.host && this.host.style.display !== 'none') return;
      this.isUIVisible = true;

      if (!this.host) {
        this.initUI();
      } else {
        this.host.style.display = 'block';
      }
      this.scan();

      this.saveUIVisibleState(true);
    }

    hideUI() {
      if (!this.isUIVisible) return;
      this.isUIVisible = false;
      if (this.host) {
        this.host.style.display = 'none';
      }

      this.saveUIVisibleState(false);
    }

