            this.showToast(`🛡 已成功屏蔽 ${count} 个威胁`);
          }, 50);
        });
      };
      */

      btnClean.onclick = async () => {
        btnClean.disabled = true;
        btnClean.textContent = '屏蔽中...';


        try {
          // 先让浏览器有机会更新按钮状态
          await new Promise(resolve => requestAnimationFrame(resolve));

          // 批量屏蔽
          const count = await this.cleanAll();

          this.showToast(`🛡 已成功屏蔽 ${count} 个威胁`);
        } catch (error) {
          console.error('[AdDetector] 一键屏蔽失败:', error);
          this.showToast('⚠️ 批量屏蔽失败，请检查控制台');
        } finally {
          // 无论成功或失败，都恢复按钮
          btnClean.disabled = false;
          btnClean.textContent = '一键屏蔽';
        }

      };


      btnReset.onclick = () => {
        btnReset.disabled = true;
        btnReset.textContent = '重置中...';
        requestAnimationFrame(() => {
          setTimeout(() => {
            const count = this.resetAll(); // 1. 清除规则并还原被屏蔽元素
            btnReset.disabled = false;
            btnReset.textContent = '一键重置';
            this.showToast(`🔄 已重置规则并还原 ${count} 个元素`);
          }, 50);
        });
      };

      btnUndo.onclick = () => this.undo();
      btnRedo.onclick = () => this.redo();
