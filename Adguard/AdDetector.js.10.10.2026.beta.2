// ==UserScript==
// @name         智能广告与覆盖层检测器 (Silent Backend + Floating UI)
// @namespace    https://tampermonkey.net/
// @version      12.6
// @description  默认静默后台防护，支持捕捉全屏透明/半透明遮罩与拦截内联/动态绑定事件劫持，包含特异性选择器生成、数量交叉校验降级防护与持久化规则恢复。
// @author       Assistant
// @match        *://*/*
// @grant        GM_addStyle
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        unsafeWindow
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  // 跨沙盒全局 window 挂载对象
  const globalWin = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;

  class UniversalAdDetector {


    // ==========================================
    // ★ 顶部进度条：独立封装
    // ==========================================
    showTopProgress() {
      let bar = document.getElementById('ad-detector-top-progress');


      if (!bar) {
        bar = document.createElement('div');
        bar.id = 'ad-detector-top-progress';

        Object.assign(bar.style, {
          position: 'fixed',
          top: '0',
          left: '0',
          width: '0%',
          height: '4px',
          background: '#00aaff',
          zIndex: '2147483647',
          pointerEvents: 'none',
          opacity: '1',
          transition: 'width 0.15s linear, opacity 0.35s ease',
          boxShadow: '0 0 8px rgba(0, 170, 255, 0.85)',
          borderRadius: '0 3px 3px 0'
        });

        document.documentElement.appendChild(bar);
      }

      // 重置进度条
      bar.style.transition = 'none';
      bar.style.width = '0%';
      bar.style.opacity = '1';

      // 强制浏览器应用初始状态
      void bar.offsetWidth;

      // 开始显示进度
      bar.style.transition = 'width 0.15s linear, opacity 0.35s ease';
      bar.style.width = '80%';

      const startTime = Date.now();
      let finished = false;

      return {
        update: (percent) => {
          if (finished) return;

          bar.style.width =
            `${Math.max(0, Math.min(100, percent))}%`;
        },

        finish: () => {
          if (finished) return;
          finished = true;

          // 即使任务很快完成，也至少显示 500ms
          const elapsed = Date.now() - startTime;
          const delay = Math.max(0, 500 - elapsed);

          setTimeout(() => {
            bar.style.width = '100%';

            setTimeout(() => {
              bar.style.opacity = '0';

              setTimeout(() => {
                bar.remove();
              }, 350);
            }, 300);
          }, delay);
        }
      };


    }



    installEventBlocker(el) {
      // alert('test')
      if (!el || el.nodeType !== Node.ELEMENT_NODE) return;
      // 防止重复安装
      if (el.__adEventBlockerInstalled) return;

      const events = [
        'click',
        'dblclick',
        'mousedown',
        'mouseup',
        'touchstart',
        'touchend',
        'touchmove',
        'pointerdown',
        'pointerup',
        'pointermove'
      ];

      const blocker = function (e) {
        try {
          // ① 阻断浏览器默认行为
          e.preventDefault();

          // ② 阻止事件继续冒泡
          e.stopPropagation();

          // ③ 阻止当前元素上后续监听器
          e.stopImmediatePropagation();
        } catch (_) { }
      };

      events.forEach(type => {
        el.addEventListener(type, blocker, true);
      });

      Object.defineProperty(el, '__adEventBlockerInstalled', {
        value: true,
        configurable: true
      });

      // 保存下来，方便以后解除
      Object.defineProperty(el, '__adEventBlocker', {
        value: {
          blocker,
          events
        },
        configurable: true
      });
    }

    // 新增：专门还原 applyExtraHideStyle 设定的样式
    removeExtraHideStyle(el) {
      if (!el || !el.tagName) return;

      // 1. 移除状态标记
      delete el.dataset.overlayBlocked;

      // 2. 修正：查找并移除统一的动态唯一类名 anti-ad-target-
      const uniqueClass = Array.from(el.classList || []).find(c => c.startsWith('anti-ad-target-'));
      if (uniqueClass) {
        el.classList.remove(uniqueClass);
      }

      // 3. 构建需要清理的选择器列表
      const selectorsToClean = [];
      if (uniqueClass) {
        selectorsToClean.push(`.${uniqueClass}`);
      }
      if (el.id) {
        selectorsToClean.push(`#${CSS.escape(el.id)}`);
      }

      // 4. 从全局动态 <style> 中精确定位并清理 CSS 规则
      const STYLE_ID = 'anti-ad-fixed-dynamic-style';
      const styleEl = document.getElementById(STYLE_ID);
      if (styleEl && styleEl.textContent && selectorsToClean.length > 0) {
        let cssText = styleEl.textContent;
        selectorsToClean.forEach(sel => {
          const escapedSel = sel.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
          const ruleRegex = new RegExp(`${escapedSel}\\s*\\{[^\\}]*\\}`, 'g');
          cssText = cssText.replace(ruleRegex, '');
        });
        styleEl.textContent = cssText;
      }

      // 5. 刷新 UI 界面
      if (this.isUIVisible) {
        this.updateUI();
      }
    }

    // 辅助隐藏样式设置

    applyExtraHideStyle(el) {
      if (!el || !el.tagName) return;

      // 2.5 事件级阻断：阻断默认行为、冒泡、同节点后续监听器
      this.installEventBlocker(el);

      // 1. 设置屏蔽标记
      el.dataset.overlayBlocked = 'true';

      // 2. 内存 Map 状态同步更新
      const adId = el.getAttribute('data-ad-detector-id') || this.registerAdElement(el);
      let meta = this.detectedAds.get(adId);
      if (meta) {
        meta.isBlocked = true;
      } else {
        this.detectedAds.set(adId, {
          id: adId,
          element: el,
          score: 40,
          reasons: ['已被额外隐藏样式屏蔽'],
          tagName: el.tagName.toLowerCase(),
          size: '1x1px',
          classAndId: el.id ? `#${el.id}` : `[data-ad-detector-id="${adId}"]`,
          fingerprint: `${el.tagName.toLowerCase()}_blocked_`,
          isBlocked: true
        });
      }

      // 3. 构建高优先级且唯一的 Selector
      let selector = '';
      if (el.id) {
        selector = `#${CSS.escape(el.id)}`;
      } else {
        // 优先使用已有的唯一 ID 属性；若无，则生成独立 Unique Class
        let uniqueClass = Array.from(el.classList).find(c => c.startsWith('anti-ad-target-'));
        if (!uniqueClass) {
          uniqueClass = 'anti-ad-target-' + Math.random().toString(36).substring(2, 9);
          el.classList.add(uniqueClass);
        }
        selector = `.${uniqueClass}`;
      }

      // 4. 应用样式规则（带去重）
      this.applyFixedAdHideRule(selector);
    }

    applyFixedAdHideRule(selector) {
      let styleEl = document.getElementById('anti-ad-fixed-dynamic-style');
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = 'anti-ad-fixed-dynamic-style';
        document.head.appendChild(styleEl);
      }

      // 校验去重：如果该 Selector 的规则已经存在，则不再重复添加
      if (styleEl.textContent.includes(selector)) {
        return;
      }

      const cssRule = `
${selector} {
    z-index: -99999 !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    width: 1px !important;
    height: 1px !important;
    min-width: 1px !important;
    min-height: 1px !important;
}
`;
      styleEl.textContent += cssRule;
    }

    // 辅助隐藏样式设置结束🔚



    // 单元素隐藏封装
    hideSingleElement(el) {
      if (!el) return;
      if (this.isSpecialStickyOrPopup(el)) {
        this.applyExtraHideStyle(el);
      } else {
        // 2.5 事件级阻断：阻断默认行为、冒泡、同节点后续监听器
        this.installEventBlocker(el);
        el.style.setProperty('display', 'none', 'important');
      }
    }
    // 单元素隐藏封装结束🔚

    // 获取目标元素高度进行排序
    getElementHeight(meta) {
      if (meta.element && meta.element.offsetHeight) {
        return meta.element.offsetHeight;
      }
      if (meta.size) {
        const match = meta.size.match(/x(\d+)px/i);
        if (match) return parseInt(match[1], 10);
      }
      return 0;
    }

    // 辅助方法
    extractXPathsFromRules(rules) {
      if (!Array.isArray(rules)) return [];
      return rules
        .filter(r => r.type === 'xpath' && r.xpath)
        .map(r => r.xpath);
    }

    constructor() {

      window.toggleHijackDefuser =
        this.toggleHijackDefuser.bind(this);
      window.toggleWindowHijackDefuser =
        this.toggleWindowHijackDefuser.bind(this);

      // ==============================
      // 恢复恶意劫持拦截按钮状态
      // ==============================

      this.restoreHijackButton();
      this.restoreWindowHijackButton();


      this.detectedAds = new Map();
      this.animatedGifCache = new Map();
      this.counter = 0;
      this.isHighlighted = false;
      this.isScanning = false;
      this.scanTimer = null;
      this.observer = null;

      // 撤回 (Undo) 与 重做 (Redo) 堆栈
      this.undoStack = [];
      this.redoStack = [];

      // 排序与筛选模式
      this.sortType = 'default';
      this.filterType = 'all';

      // 面板显示状态标识
      this.host = null;
      this.shadow = null;

      // 域隔离持久化规则库
      this.storageKey = `ad_detector_blocked_${window.location.hostname}`;
      this.blockedRules = this.loadBlockedRules();
      // 【新增】提取内存中的 XPath 集合
      this.blockedXPaths = this.extractXPathsFromRules(this.blockedRules);

      // 读取上次页面留下的面板开启状态
      this.isUIVisible = this.loadUIVisibleState();

      // 拦截内联与动态事件劫持防护机制
      this.initClickHijackProtection();

      this.injectGlobalStyles();
      this.applyCssRulesFromStorage(); // 持久化 CSS 规则转译
      this.initObserver();
      this.bindGlobalHotkeys();

      // 立即强制触发 1 次同步全盘清理与持久化规则恢复
      this.forceCleanSavedRulesImmediately();

      // 如果记忆状态为开启，页面加载时自动显示面板
      if (this.isUIVisible) {
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', () => this.showUI());
        } else {
          this.showUI();
        }
      }

    }


    // ==============================
    // 切换按钮状态
    // ==============================

    toggleHijackDefuser() {

      const button =
        this.shadow.querySelector('#btn-hijack');

      if (!button) return;

      const enabled =
        localStorage.getItem('hijackDefuser') === '1';

      const newState = !enabled;

      // 保存状态
      localStorage.setItem(
        'hijackDefuser',
        newState ? '1' : '0'
      );

      // 更新按钮文字
      button.textContent = newState
        ? '拦截恶意点击跳转'
        : '拦截恶意点击跳转';

      // 更新按钮颜色
      button.classList.toggle('active', newState);

      // 提示
      this.showToast(
        newState
          ? '✅ 拦截恶意点击跳转：已开启，刷新页面即可测试效果...(右上角或可查看拦截日志📔，若误伤正常跳转，请关闭)'
          : '拦截恶意点击跳转：已关闭，请刷新页面'
      );
    }


    toggleWindowHijackDefuser() {
      const button =
        this.shadow.querySelector('#btn-window-hijack');

      if (!button) return;

      const enabled =
        localStorage.getItem('windowhijackDefuser') === '1';

      const newState = !enabled;

      // 保存状态
      localStorage.setItem(
        'windowhijackDefuser',
        newState ? '1' : '0'
      );

      // 更新按钮文字
      button.textContent = newState
        ? '拦截点击弹窗广告'
        : '拦截点击弹窗广告';

      // 更新按钮颜色
      button.classList.toggle('active', newState);

      // 提示
      this.showToast(
        newState
          ? '✅ 拦截点击弹窗广告：已开启，刷新页面即可测试效果...(若误伤正常新窗口打开，请关闭)'
          : '拦截点击弹窗广告：已关闭，请刷新页面'
      );
    }


    // ==============================
    // 刷新页面后恢复按钮状态
    // ==============================

    restoreHijackButton() {

      const restoreTimer = setInterval(() => {

        const button =
          this.shadow?.querySelector('#btn-hijack');

        // 按钮还没生成，继续等待
        if (!button) return;

        const enabled =
          localStorage.getItem('hijackDefuser') === '1';

        button.textContent = enabled
          ? '拦截恶意点击跳转'
          : '拦截恶意点击跳转';


        // 恢复按钮颜色
        button.classList.toggle('active', enabled);

        // 找到按钮后停止循环
        clearInterval(restoreTimer);

      }, 500);
    }


    restoreWindowHijackButton() {

      const restoreTimer = setInterval(() => {

        const button =
          this.shadow?.querySelector('#btn-window-hijack');

        // 按钮还没生成，继续等待
        if (!button) return;

        const enabled =
          localStorage.getItem('windowhijackDefuser') === '1';

        button.textContent = enabled
          ? '拦截点击弹窗广告'
          : '拦截点击弹窗广告';


        // 恢复按钮颜色
        button.classList.toggle('active', enabled);

        // 找到按钮后停止循环
        clearInterval(restoreTimer);

      }, 500);
    }



    // ==========================================
    // ★ 模块一：精准特异性选择器生成器
    // ==========================================
    generateSpecificSelector(el) {
      if (!el || el.nodeType !== Node.ELEMENT_NODE) return '';

      // 1. 如果存在稳固的 ID（过滤纯数字/随机长字串 ID）
      if (el.id && !/\d{5,}/.test(el.id)) {
        return `#${CSS.escape(el.id)}`;
      }

      const path = [];
      let current = el;

      while (current && current.nodeType === Node.ELEMENT_NODE && current !== document.body && current !== document.documentElement) {
        let selector = current.tagName.toLowerCase();

        // 过滤掉动态/无意义 class，保留有辨识度的 class
        const validClasses = Array.from(current.classList || []).filter(
          c => !/^[0-9_-]+$/.test(c) && !/^(active|show|hide|visible|hover|focus|ad-detector-)/.test(c)
        );

        if (validClasses.length > 0) {
          selector += `.${validClasses.map(c => CSS.escape(c)).join('.')}`;
        }

        // 拼接特征属性约束（如 data-ad-id, href 等）
        if (current.hasAttribute('data-ad-id')) {
          selector += `[data-ad-id="${CSS.escape(current.getAttribute('data-ad-id'))}"]`;
        } else if (current.tagName === 'A' && current.hasAttribute('href')) {
          const href = current.getAttribute('href');
          if (href && href.length < 60) {
            selector += `[href="${CSS.escape(href)}"]`;
          }
        }

        // 追加同级节点 index 约束
        let sibling = current;
        let nth = 1;
        while ((sibling = sibling.previousElementSibling)) {
          if (sibling.tagName === current.tagName) nth++;
        }
        if (nth > 1) {
          selector += `:nth-of-type(${nth})`;
        }

        path.unshift(selector);
        current = current.parentElement;

        // 路径向上溯源到 3 层时提前终止，防止选择器过长
        if (path.length >= 3) break;
      }

      return path.join(' > ');
    }

    // ==========================================
    // ★ 模块二：生成绝对精确的 XPath（降级备份用）
    // ==========================================
    getElementXPath(element) {
      if (!element) return '';
      if (element.id && !/\d{5,}/.test(element.id)) return `//*[@id="${element.id}"]`;
      if (element === document.body) return '/html/body';

      let ix = 0;
      const siblings = element.parentNode ? element.parentNode.childNodes : [];

      for (let i = 0; i < siblings.length; i++) {
        const sibling = siblings[i];
        if (sibling === element) {
          return `${this.getElementXPath(element.parentNode)}/${element.tagName.toLowerCase()}[${ix + 1}]`;
        }
        if (sibling.nodeType === 1 && sibling.tagName === element.tagName) {
          ix++;
        }
      }
      return '';
    }

    // ==========================================
    // ★ 撤回 (Undo) / 重做 (Redo) 核心逻辑
    // ==========================================
    pushHistoryState(action) {
      this.undoStack.push(action);
      this.redoStack = [];
      this.updateUI();
    }

    undo() {
      if (this.undoStack.length === 0) return;
      const action = this.undoStack.pop();

      if (action.type === 'SINGLE_BLOCK' || action.type === 'BATCH_BLOCK') {
        action.items.forEach(adId => this.restoreSingleInternal(adId));
        this.showToast(`↩ 已撤回屏蔽操作 (${action.items.length} 个元素)`);
      } else if (action.type === 'SINGLE_RESTORE') {
        action.items.forEach(adId => this.neutralizeSingleInternal(adId));
        this.showToast(`↩ 已撤回恢复操作 (${action.items.length} 个元素)`);
      }

      this.redoStack.push(action);
      this.updateUI();
    }

    redo() {
      if (this.redoStack.length === 0) return;
      const action = this.redoStack.pop();

      if (action.type === 'SINGLE_BLOCK' || action.type === 'BATCH_BLOCK') {
        action.items.forEach(adId => this.neutralizeSingleInternal(adId));
        this.showToast(`↪️ 已重做屏蔽操作 (${action.items.length} 个元素)`);
      } else if (action.type === 'SINGLE_RESTORE') {
        action.items.forEach(adId => this.restoreSingleInternal(adId));
        this.showToast(`↪️ 已重做恢复操作 (${action.items.length} 个元素)`);
      }

      this.undoStack.push(action);
      this.updateUI();
    }


    // ==========================================
    // ★ 特殊悬浮/贴片 节点特征判定器
    // ==========================================
    isSpecialStickyOrPopup(target) {
      if (!target) return false;

      // 1. 如果传入的是 adId 或 meta 对象
      let meta = null;
      let el = null;

      if (typeof target === 'string') {
        meta = this.detectedAds.get(target);
        el = meta ? meta.element : null;
      } else if (target.element) {
        meta = target;
        el = meta.element;
      } else if (target instanceof HTMLElement) {
        el = target;
        const adId = el.getAttribute('data-ad-detector-id');
        meta = adId ? this.detectedAds.get(adId) : null;
      }

      // 2. 依据 meta 中记录的诊断原因判定
      if (meta && Array.isArray(meta.reasons)) {
        const hasSpecialReason = meta.reasons.some(reason =>
          reason.includes('贴片弹窗') ||
          reason.includes('黏性容器')
        );
        if (hasSpecialReason) return true;
      }

      // 优化后的兜底逻辑示例
      if (el && el instanceof HTMLElement && el.isConnected) {
        try {
          const style = window.getComputedStyle(el);
          const position = style.position;
          const zIndexAttr = style.zIndex;
          const zIndex = parseInt(zIndexAttr, 10) || 0;

          // 1. sticky 必须有较高 z-index 才算特殊；fixed 限制较高 z-index 或显式定义
          const isStickySpecial = position === 'sticky' && zIndex >= 50;
          const isFixedSpecial = position === 'fixed' && (zIndex >= 50 || zIndexAttr === 'auto');

          if (isStickySpecial || isFixedSpecial) {
            return true;
          }
        } catch (e) {
          // 忽略样式读取异常
        }
      }
      return false;

    }

    // ==========================================
    // ★ 模块三 & 四：safeBlockElement 安全屏蔽 + 交叉校验 + 降级 + 规则持久化
    // ==========================================
    neutralizeSingleInternal(adId) {

      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element) return;

      const targetEl = meta.element;
      meta.isBlocked = true;
      targetEl.dataset.overlayBlocked = 'true';

      this.applyHighlight(targetEl, false);

      // 【核心修改】调用封装好的检查函数
      const isSpecial = this.isSpecialStickyOrPopup(meta);

      // 1. 生成候选 CSS 选择器
      const candidateSelector = this.generateSpecificSelector(targetEl);

      // 2. 数量交叉校验
      // 计算预期匹配数 (N_expected)
      let N_expected = 0;
      this.detectedAds.forEach(item => {
        if (!item || !item.element) return;
        if (item.element === targetEl ||
          (
            candidateSelector &&
            this.generateSpecificSelector(item.element) === candidateSelector
          )
        ) {
          N_expected++;
        }
      });

      N_expected = Math.max(1, N_expected);

      // 计算实际 DOM 匹配数 (N_actual)
      let matchedElements = [];
      try {
        if (candidateSelector) {
          matchedElements = document.querySelectorAll(candidateSelector);
        }
      } catch (e) {
        console.warn('[AdDetector] 选择器语法异常:', candidateSelector, e);
      }

      const N_actual = matchedElements.length;

      // 3. 判定分流与降级策略执行
      if (N_actual > 0 && N_actual <= N_expected) {

        // 1. 隐藏主节点 targetEl
        this.hideSingleElement(targetEl);

        // 2. 隐藏匹配到的所有节点（包括或不包括 targetEl 均安全）
        matchedElements.forEach(el => this.hideSingleElement(el));

        const rule = {
          type: 'css',
          selector: candidateSelector,
          classAndId: meta.classAndId,
          tagName: meta.tagName,
          size: meta.size,
          fingerprint: meta.fingerprint,
          hideMethod: isSpecial ? 'extra' : 'default'
        };

        if (!this.blockedRules.some(r => r.selector === candidateSelector || r.fingerprint === rule.fingerprint)) {
          this.blockedRules.push(rule);
          this.saveBlockedRules();
        }
      } else {
        // 【分支 B：实际匹配超标，存在误伤风险】 -> 降级为单节点内联隐藏 + 精准 XPath 规则
        console.warn(`[AdDetector] 误伤预警: "${candidateSelector}" 实际匹配 ${N_actual} 个, 预期 ${N_expected} 个。执行单节点 XPath 降级。`);

        meta.isDowngraded = true; // 👈 新增：标记为降级/有误伤风险
        meta.downgradeReason = `选择器匹配了 ${N_actual} 个节点，远超预期 ${N_expected} 个`; // 👈 新增原因说明


        if (isSpecial) {
          this.hideSingleElement(targetEl);
        } else {
          // 2.5 事件级阻断：阻断默认行为、冒泡、同节点后续监听器
          // this.installEventBlocker(el);
          this.installEventBlocker(targetEl);
          targetEl.style.setProperty('display', 'none', 'important'); // 修正为隐藏
        }

        const exactXPath = this.getElementXPath(targetEl);

        const rule = {
          type: 'xpath',
          xpath: exactXPath,
          classAndId: meta.classAndId,
          tagName: meta.tagName,
          size: meta.size,
          fingerprint: meta.fingerprint,
          hideMethod: isSpecial ? 'extra' : 'default'
        };

        if (!this.blockedRules.some(r => r.xpath === exactXPath || r.fingerprint === rule.fingerprint)) {
          this.blockedRules.push(rule);
          this.saveBlockedRules();
        }
      }
    }

    // 内部恢复逻辑
    restoreSingleInternal(adId) {

      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element) return;

      const targetElement = meta.element;

      // 1. 获取当前节点以及所有被连带标记的子节点
      const affectedNodes = [
        targetElement,
        ...targetElement.querySelectorAll('[data-overlay-blocked="true"]')
      ];

      // 2. 遍历恢复所有受影响 DOM 节点及其对应内存中的 meta 状态
      affectedNodes.forEach((node) => {
        // 移除 DOM 隐藏标记与内联 display 属性
        delete node.dataset.overlayBlocked;
        node.style.removeProperty('display');
        this.removeExtraHideStyle(node);

        // 同步更新 detectedAds 映射表中的内存状态
        // 假设每个 ad 节点 DOM 上均存有关联的 ID 标识（如 data-ad-id）
        const nodeAdId = node.dataset.adDetectorId || adId;
        const nodeMeta = this.detectedAds.get(nodeAdId);
        if (nodeMeta) {
          nodeMeta.isBlocked = false;
        }

        // 恢复高亮逻辑
        if (this.isHighlighted && nodeMeta) {
          this.applyHighlight(node, true, nodeMeta.size);
        }
      });

      // 3. 清理对应的拦截规则
      const currentSelector = this.generateSpecificSelector(targetElement);
      const currentXPath = this.getElementXPath(targetElement);

      this.blockedRules = this.blockedRules.filter(
        (r) => !(
          (r.selector && r.selector === currentSelector) ||
          (r.xpath && r.xpath === currentXPath) ||
          (r.fingerprint && r.fingerprint === meta.fingerprint) ||
          (r.classAndId && r.classAndId === meta.classAndId)
        )
      );

      this.saveBlockedRules();
      this.applyCssRulesFromStorage();
    }



