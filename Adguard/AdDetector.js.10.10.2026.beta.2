    }

    makeDraggable() {

      const panel =
        this.shadow.querySelector('#main-panel');

      const header =
        this.shadow.querySelector('#panel-header');

      const edges =
        this.shadow.querySelectorAll('.edge-drag');


      if (!panel || !header) return;


      let isDragging = false;

      let startX = 0;
      let startY = 0;

      let currentTranslateX = 0;
      let currentTranslateY = 0;

      let startTranslateX = 0;
      let startTranslateY = 0;


      // ==============================
      // 恢复上次位置
      // ==============================

      try {

        let savedPos = null;

        if (typeof GM_getValue !== 'undefined') {

          savedPos =
            GM_getValue(
              'ad_detector_panel_transform',
              null
            );

        } else if (window.localStorage) {

          savedPos =
            JSON.parse(
              localStorage.getItem(
                'ad_detector_panel_transform'
              ) || 'null'
            );

        }


        if (
          savedPos &&
          savedPos.x !== undefined &&
          savedPos.y !== undefined
        ) {

          currentTranslateX = savedPos.x;
          currentTranslateY = savedPos.y;

          panel.style.transform =
            `translate3d(
                    ${currentTranslateX}px,
                    ${currentTranslateY}px,
                    0
                )`;

        }

      } catch (e) { }


      // ==============================
      // 开始拖动
      // ==============================

      const startDrag = (e) => {

        if (
          e.target.closest('#btn-close-panel') ||
          e.target.closest('.select-control')
        ) {
          return;
        }


        if (
          e.button !== undefined &&
          e.button !== 0
        ) {
          return;
        }


        isDragging = true;



        startX = e.clientX;
        startY = e.clientY;

        startTranslateX = currentTranslateX;
        startTranslateY = currentTranslateY;

        document.body.style.userSelect = 'none';

        e.preventDefault();

      };


      // ==============================
      // 拖动
      // ==============================

      const moveDrag = (e) => {

        if (!isDragging) return;


        const deltaX =
          e.clientX - startX;

        const deltaY =
          e.clientY - startY;


        currentTranslateX =
          startTranslateX + deltaX;

        currentTranslateY =
          startTranslateY + deltaY;


        panel.style.transform =
          `translate3d(
                ${currentTranslateX}px,
                ${currentTranslateY}px,
                0
            )`;

      };


      // ==============================
      // 停止拖动
      // ==============================

      const stopDrag = () => {

        if (!isDragging) return;

        isDragging = false;

        document.body.style.userSelect = '';


        const posData = {
          x: currentTranslateX,
          y: currentTranslateY
        };


        try {

          if (typeof GM_setValue !== 'undefined') {

            GM_setValue(
              'ad_detector_panel_transform',
              posData
            );

          } else if (window.localStorage) {

            localStorage.setItem(
              'ad_detector_panel_transform',
              JSON.stringify(posData)
            );

          }

        } catch (err) {

          console.warn(
            '[AdDetector] 无法保存面板位置',
            err
          );

        }

      };


      // ==============================
      // 使用 onpointer* 属性
      // 不经过 addEventListener
      // ==============================

      const dragTargets = [
        header,
        ...edges
      ];


      dragTargets.forEach((el) => {

        if (!el) return;

        el.onpointerdown = startDrag;

      });


      window.onpointermove = moveDrag;

      window.onpointerup = stopDrag;

      window.onpointercancel = stopDrag;

    }

    applyHighlight(el, enable, sizeText = '') {
      if (!el || el.dataset.overlayBlocked === 'true') {
        el.classList.remove('ad-detector-highlight-active', 'ad-detector-pos-relative');
        return;
      }

      if (enable) {
        if (window.getComputedStyle(el).position === 'static') {
          el.classList.add('ad-detector-pos-relative');
        }

        let badge = el.querySelector(':scope > .ad-detector-size-badge');
        if (!badge) {
          badge = document.createElement('div');
          badge.className = 'ad-detector-size-badge';
          el.appendChild(badge);
        }

        // 核心修复点：若未显式传入 sizeText，统一从 meta 获取并拼接 tagName 和 size
        if (!sizeText) {
          const adId = el.getAttribute('data-ad-detector-id');
          const meta = this.detectedAds.get(adId);
          if (meta) {
            sizeText = `${meta.tagName} 宽高:${meta.size}`;
          } else {
            sizeText = `${el.tagName.toLowerCase()} 宽高:${el.offsetWidth || 0}x${el.offsetHeight || 0}px`;
          }
        }

        if (badge.dataset.size !== sizeText) {
          badge.dataset.size = sizeText;
        }

        el.classList.add('ad-detector-highlight-active');
      } else {
        el.classList.remove('ad-detector-highlight-active', 'ad-detector-pos-relative');
      }
    }

    toggleHighlight() {
      this.isHighlighted = !this.isHighlighted;
      for (const meta of this.detectedAds.values()) {
        if (meta.element && !meta.isBlocked) {
          // 保持在这里进行拼接，meta.size 依然是原始数值
          this.applyHighlight(meta.element, this.isHighlighted, meta.tagName + " 宽高:" + meta.size);
        }
      }
    }

    showPreviewWindow(adId) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element) return;

      const modal = this.shadow.querySelector('#preview-modal');
      const container = this.shadow.querySelector('#preview-container');
      const title = this.shadow.querySelector('#preview-title');
      const actionsContainer = this.shadow.querySelector('#preview-actions');

      title.textContent = `🔍 预览: <${meta.tagName}> (${meta.size})`;
      container.innerHTML = '';

      const cloneForCode = meta.element.cloneNode(true);
      cloneForCode.removeAttribute('data-ad-detector-id');
      const badgeInClone = cloneForCode.querySelector('.ad-detector-size-badge');
      if (badgeInClone) badgeInClone.remove();

      const rawHtml = cloneForCode.outerHTML;

      const iframe = document.createElement('iframe');
      iframe.style.setProperty('width', '100%', 'important');
      iframe.style.setProperty('height', '200px', 'important');
      iframe.style.setProperty('border', 'none', 'important');
      iframe.style.setProperty('background', 'transparent', 'important');

      container.appendChild(iframe);

      const iframeDoc = iframe.contentDocument || iframe.contentWindow.document;
      iframeDoc.open();
      iframeDoc.write(`
        <!DOCTYPE html>
        <html>
        <head>
          <meta charset="utf-8">
          <style>
            body {
              margin: 0;
              padding: 16px;
              display: flex;
              justify-content: center;
              align-items: center;
              min-height: 100vh;
              box-sizing: border-box;
              background: transparent;
              overflow: auto;
            }
          </style>
        </head>
        <body>
          <div id="iframe-preview-root"></div>
        </body>
        </html>
      `);
      iframeDoc.close();

      const iframeHead = iframeDoc.head;
      document.querySelectorAll('style').forEach((styleTag) => {
        if (styleTag.id !== 'ad-detector-global-styles' && styleTag.id !== 'ad-detector-dynamic-css-rules') {
          iframeHead.appendChild(styleTag.cloneNode(true));
        }
      });

      document.querySelectorAll('link[rel="stylesheet"]').forEach((linkTag) => {
        const clonedLink = linkTag.cloneNode(true);
        if (clonedLink.href) clonedLink.href = clonedLink.href;
        iframeHead.appendChild(clonedLink);
      });

      const origRect = meta.element.getBoundingClientRect();
      const origStyle = window.getComputedStyle(meta.element);
      const cloneForRender = cloneForCode.cloneNode(true);

      const finalWidth = origRect.width > 0 ? origRect.width : (parseInt(meta.size.split('x')[0]) || 300);
      const finalHeight = origRect.height > 0 ? origRect.height : (parseInt(meta.size.split('x')[1]) || 250);

      cloneForRender.style.setProperty('display', 'block', 'important');
      cloneForRender.style.setProperty('position', 'relative', 'important');
      cloneForRender.style.setProperty('visibility', 'visible', 'important');
      cloneForRender.style.setProperty('opacity', '1', 'important');
      cloneForRender.style.setProperty('transform', 'none', 'important');
      cloneForRender.style.setProperty('transition', 'none', 'important');
      cloneForRender.style.setProperty('margin', '0 auto', 'important');
      cloneForRender.style.setProperty('width', `${finalWidth}px`, 'important');
      cloneForRender.style.setProperty('height', `${finalHeight}px`, 'important');

      if (origStyle.backgroundColor && origStyle.backgroundColor !== 'rgba(0, 0, 0, 0)' && origStyle.backgroundColor !== 'transparent') {
        cloneForRender.style.setProperty('background-color', origStyle.backgroundColor, 'important');
      }

      const root = iframeDoc.getElementById('iframe-preview-root');
      root.appendChild(cloneForRender);

      let codeSection = this.shadow.querySelector('#preview-code-section');
      if (!codeSection) {
        const previewBody = this.shadow.querySelector('.preview-body');
        codeSection = document.createElement('div');
        codeSection.id = 'preview-code-section';
        codeSection.innerHTML = `
          <div class="preview-section-title">
            <span>📄 元素原代码 (HTML)</span>
            <button class="btn-copy-code" id="btn-copy-code">复制源码</button>
          </div>
          <div class="code-container" id="preview-code-container">
            <pre class="code-block" id="preview-code-block"></pre>
          </div>
        `;
        previewBody.appendChild(codeSection);
      }

      const codeBlock = this.shadow.querySelector('#preview-code-block');
      const copyBtn = this.shadow.querySelector('#btn-copy-code');

      codeBlock.textContent = rawHtml;

      copyBtn.onclick = () => {
        navigator.clipboard.writeText(codeBlock.textContent).then(() => {
          copyBtn.textContent = '已复制！';
          setTimeout(() => { copyBtn.textContent = '复制源码'; }, 1500);
        }).catch(err => {
          console.error('复制代码失败:', err);
        });
      };

      const renderPreviewActions = () => {
        if (!meta.isBlocked) {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-hide-single" id="btn-preview-hide">🚫 单独屏蔽</button>
          `;
          const btnHide = actionsContainer.querySelector('#btn-preview-hide');
          btnHide.onclick = () => {
            this.neutralizeSingle(adId);
            renderPreviewActions();
            setTimeout(() => {
              modal.style.display = 'none';
              container.innerHTML = '';
            }, 1200);
          };
        } else {
          actionsContainer.innerHTML = `
            <button class="btn-action btn-restore-single" id="btn-preview-restore">↩️ 撤销屏蔽</button>
          `;
          const btnRestore = actionsContainer.querySelector('#btn-preview-restore');
          btnRestore.onclick = () => {
            this.restoreSingle(adId);
            renderPreviewActions();
          };
        }
      };

      renderPreviewActions();

      modal.style.display = 'flex';

      const closeBtn = this.shadow.querySelector('#btn-close-preview');
      closeBtn.onclick = () => {
        modal.style.display = 'none';
        container.innerHTML = '';
        this.updateUI();
      };
    }

    previewHoverElement(adId, isHovering) {
      const meta = this.detectedAds.get(adId);
      if (!meta || !meta.element || meta.isBlocked) return;

      if (this.observer) {
        this.observer.disconnect();
      }

      if (isHovering) {
        meta.element.classList.add('ad-detector-hover-active');

        // 使元素平滑滚动至视野中央
        try {
          meta.element.scrollIntoView({
            behavior: 'smooth', // 平滑动画
            block: 'center',    // 垂直方向居中
            inline: 'center'    // 水平方向居中
          });
        } catch (e) {
          // 兼容旧版浏览器的降级处理
          meta.element.scrollIntoView(false);
        }
      } else {
        meta.element.classList.remove('ad-detector-hover-active');

        const activeChildren = meta.element.querySelectorAll('.ad-detector-hover-active');
        activeChildren.forEach(child => child.classList.remove('ad-detector-hover-active'));

        if (this.isHighlighted) {
          // this.applyHighlight(meta.element, true, meta.size);
          this.applyHighlight(meta.element, true);
        }
      }

      if (this.observer && document.body) {
        this.observer.observe(document.body, {
          childList: true,
          subtree: true,
          attributes: true,
          attributeFilter: ['style', 'class', 'src']
        });
      }
    }


