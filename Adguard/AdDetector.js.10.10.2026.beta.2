    updateUI() {
      if (!this.shadow) return;
      const listEl = this.shadow.querySelector('#list');
      const badge = this.shadow.querySelector('#count-badge');
      const btnUndo = this.shadow.querySelector('#btn-undo');
      const btnRedo = this.shadow.querySelector('#btn-redo');

      if (btnUndo) btnUndo.disabled = this.undoStack.length === 0;
      if (btnRedo) btnRedo.disabled = this.redoStack.length === 0;

      let allDetected = Array.from(this.detectedAds.values());
      const activeUnreadThreats = allDetected.filter((meta) => !meta.isBlocked);

      badge.textContent = `${activeUnreadThreats.length} 未处理 / 共 ${allDetected.length} 个`;

      if (allDetected.length === 0) {
        listEl.innerHTML = '<div style="text-align:center;color:#30d158;padding:20px;">未发现高风险劫持或广告元素</div>';
        return;
      }

      if (this.filterType === 'unread') {
        allDetected = allDetected.filter((meta) => !meta.isBlocked);
      } else if (this.filterType === 'blocked') {
        allDetected = allDetected.filter((meta) => meta.isBlocked);
      }

      if (allDetected.length === 0) {
        const filterTextMap = { unread: '未处理', blocked: '已屏蔽' };
        listEl.innerHTML = `<div style="text-align:center;color:#8e8e93;padding:20px;">没有符合 [${filterTextMap[this.filterType] || '当前'}] 筛选条件的项</div>`;
        return;
      }

      allDetected.sort((a, b) => {
        if (this.sortType === 'height') {
          return this.getElementHeight(b) - this.getElementHeight(a);
        }
        // 默认排序（按风险分数降序）
        return b.score - a.score;
      });

      let html = '';
      allDetected.forEach((meta) => {
        const isBlocked = meta.isBlocked;
        const isDowngraded = meta.isDowngraded || false;

        // 状态标签生成逻辑（区分常规屏蔽与降级防误伤屏蔽）
        let statusHtml = `<span class="score">${meta.score}分</span>`;
        if (isBlocked) {
          if (isDowngraded) {
            statusHtml = `<div><span class="status-tag" style="background:rgba(255,149,0,0.25);color:#ff9500;">⚠️ 降级防误伤</span> <span class="score">${meta.score}分</span></div>`;
          } else {
            statusHtml = `<div><span class="status-tag">已屏蔽</span> <span class="score">${meta.score}分</span></div>`;
          }
        }

        // 预警说明信息
        const downgradeWarnHtml = isBlocked && isDowngraded && meta.downgradeReason
          ? `<div style="font-size:11px;color:#ff9500;margin-top:4px;line-height:1.3;background:rgba(255,149,0,0.1);padding:4px 6px;border-radius:4px;">
           ⚠️ <strong>误伤预警：</strong>${meta.downgradeReason}
         </div>`
          : '';

        html += `
      <div class="item ${isBlocked ? 'is-blocked' : ''}" data-ad-id="${meta.id}">
        <div class="item-top">
          <div class="item-title">
            <strong>${meta.tagName}</strong>
            <span style="color:#8e8e93;"> 宽高:${meta.size}</span>
          </div>
          ${statusHtml}
        </div>
        <div style="font-size:11px;color:#0a84ff;word-break:break-all;margin-top:2px;">${meta.classAndId || '无 Class/ID'}</div>
        <div class="reasons">原因: ${meta.reasons.join(' | ')}</div>
        ${downgradeWarnHtml}
        <div class="actions">
          ${!isBlocked
            ? `<button class="btn-action btn-preview" data-action="preview" data-id="${meta.id}">🔍 预览元素</button>
               <button class="btn-action btn-hide-single" data-action="hide" data-id="${meta.id}">🚫 单独屏蔽</button>`
            : `<button class="btn-action btn-preview" data-action="preview" data-id="${meta.id}">🔍 预览元素</button>
            <button class="btn-action btn-restore-single" data-action="restore" data-id="${meta.id}">↩️ 撤销屏蔽</button>`
          }
        </div>
      </div>
    `;
      });
      listEl.innerHTML = html;

      listEl.querySelectorAll('.item').forEach((item) => {
        const adId = item.getAttribute('data-ad-id');

        const isTouchDevice =
          'ontouchstart' in window ||
          navigator.maxTouchPoints > 0;

        // PC 端：鼠标悬停预览
        if (!isTouchDevice) {
          item.onpointerenter = (e) => {
            e.stopPropagation();
            this.previewHoverElement(adId, true);
          };

          item.onpointerleave = (e) => {
            e.stopPropagation();
            this.previewHoverElement(adId, false);
          };
        } else {
          // 移动端：点击卡片切换预览状态
          item.onclick = (e) => {
            if (e.target.closest('.btn-action')) {
              return;
            }

            e.stopPropagation();

            const currentActiveId = this.activeTouchAdId;

            if (currentActiveId === adId) {
              this.previewHoverElement(adId, false);
              this.activeTouchAdId = null;
            } else {
              if (currentActiveId) {
                this.previewHoverElement(currentActiveId, false);
              }

              this.previewHoverElement(adId, true);
              this.activeTouchAdId = adId;
            }
          };
        }

        // 统一处理按钮点击
        // 使用 onclick，避免依赖 addEventListener
        item.onclick = isTouchDevice
          ? ((originalHandler) => {
            return (e) => {
              if (e.target.closest('.btn-action')) {
                e.stopPropagation();

                const btn = e.target.closest('.btn-action');
                const action = btn.getAttribute('data-action');
                const id = btn.getAttribute('data-id');

                if (action === 'preview') {
                  this.showPreviewWindow(id);
                } else if (action === 'hide') {
                  this.neutralizeSingle(id);
                } else if (action === 'restore') {
                  this.restoreSingle(id);
                }

                return;
              }

              originalHandler(e);
            };
          })(item.onclick)
          : (e) => {
            const btn = e.target.closest('.btn-action');
            if (!btn) return;

            e.stopPropagation();

            const action = btn.getAttribute('data-action');
            const id = btn.getAttribute('data-id');

            if (action === 'preview') {
              this.showPreviewWindow(id);
            } else if (action === 'hide') {
              this.neutralizeSingle(id);
            } else if (action === 'restore') {
              this.restoreSingle(id);
            }
          };
      });

      if (!this.hasTouchGlobalListener) {
        document.addEventListener('click', (e) => {
          if (!e.target.closest('.ad-detector-container') && this.activeTouchAdId) {
            this.previewHoverElement(this.activeTouchAdId, false);
            this.activeTouchAdId = null;
          }
        });
        this.hasTouchGlobalListener = true;
      }
    }

  }


  // 全局测试进度条
  window.testAdDetectorProgress = function () {
    const detector = window.getDetector();
    const progress = detector.showTopProgress();

    let percent = 0;

    const timer = setInterval(() => {
      percent += 10;
      progress.update(percent);

      if (percent >= 90) {
        clearInterval(timer);
        progress.finish();
      }
    }, 200);

    return '进度条测试已启动';
  };

  // 单例挂载
  let instance = null;
  function getDetector() {
    if (!instance) {
      instance = new UniversalAdDetector();
    }
    return instance;
  }

  // 暴露到全局
  window.getDetector = getDetector;

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => getDetector());
    window.testAdDetectorProgress();
  } else {
    getDetector();
    window.testAdDetectorProgress();
  }

  // 绑定至全局 window 对象
  globalWin.toggleAdDetectorUI = function () {
    getDetector().toggleUI();
  };

  globalWin.showAdDetectorUI = function () {
    getDetector().showUI();
  };

  globalWin.hideAdDetectorUI = function () {
    getDetector().hideUI();
  };

  globalWin.cleanAdsSilently = function () {
    return getDetector().cleanAll();
  };

  // ✅ 修正写法：通过闭包包装，接收参数并转发给单例实例
  globalWin.showToast = function (message) {
    getDetector().showToast(message);
  };


  // 查看 addEventListener_defuserV2(needle1 = '', needle2 = '') 记录
  globalWin.startEventLogViewerV3 = function (message) {
    getDetector().startEventLogViewerV3();
  };

})();





