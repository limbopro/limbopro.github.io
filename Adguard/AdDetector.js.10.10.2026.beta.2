          const elementId = record.elementId
            ? ` #${record.elementId}`
            : '';
          summary.textContent =
            `${index + 1}. ${type}${elementId} · ${record.time || '无时间'}`;

          card.appendChild(summary);

          let elementText = '';
          try {
            elementText = typeof record.element === 'string'
              ? record.element
              : JSON.stringify(record.element, null, 2);
          } catch (e) {
            elementText = '[元素信息无法显示]';
          }

          addText(card, 'ev-meta', `事件类型：${type}`);
          addText(card, 'ev-meta', `元素 ID：${record.elementId || '(无)'}`);
          addText(card, 'ev-meta', `时间：${record.time || '(无)'}`);
          addText(card, 'ev-meta', `监听目标：${elementText || '(无)'}`);

          addText(card, 'ev-section', 'Handler / 处理器源码');
          const handler = document.createElement('pre');
          handler.textContent = String(record.handler || '(无处理器内容)');
          card.appendChild(handler);

          addText(card, 'ev-section', 'Stack / 调用堆栈');
          const stack = document.createElement('pre');
          stack.textContent = String(record.stack || '(无堆栈信息)');
          card.appendChild(stack);

          const actions = document.createElement('div');
          actions.style.cssText =
            'display:flex;gap:8px;flex-wrap:wrap;margin-top:10px';

          const copyRecordBtn = document.createElement('button');
          copyRecordBtn.textContent = '复制本条 JSON';
          copyRecordBtn.addEventListener('click', async () => {
            try {
              await copyText(JSON.stringify(record, null, 2));
              copyRecordBtn.textContent = '已复制';
              setTimeout(() => {
                copyRecordBtn.textContent = '复制本条 JSON';
              }, 1200);
            } catch (e) {
              alert('复制失败，请检查浏览器剪贴板权限。');
            }
          });

          actions.appendChild(copyRecordBtn);
          card.appendChild(actions);
          fragment.appendChild(card);
        });

        list.appendChild(fragment);
      }

      async function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }

        const textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.style.cssText =
          'position:fixed;left:-9999px;top:0;opacity:0';
        document.body.appendChild(textarea);
        textarea.select();

        const success = document.execCommand('copy');
        textarea.remove();

        if (!success) throw new Error('Copy failed');
      }

      function refresh() {
        data = records();
        render();
      }

      fab.addEventListener('click', () => {
        if (dragged) {
          dragged = false;
          return;
        }
        panel.style.display =
          panel.style.display === 'flex' ? 'none' : 'flex';
        if (panel.style.display === 'flex') refresh();
      });

      closeBtn.addEventListener('click', () => {
        panel.style.display = 'none';
      });

      refreshBtn.addEventListener('click', refresh);

      copyBtn.addEventListener('click', async () => {
        try {
