#!/bin/bash

# --- 变量定义 ---
# 归档目录：包含 daily.json (最新) 和 old.json (历史)
ARCHIVE_DIR="/home/typecho/tools/jwksm/daily"

# 临时目录 (同时也是 jwksm.js 脚本的实际位置)
TEMP_DIR="/home/typecho/tools/jwksm/temp"
TOOL_DIR="/home/typecho/tools/jwksm/temp" # <--- 修正: 脚本现在从这里运行

echo "[$(date '+%Y-%m-%d %H:%M:%S')] 脚本启动..."

# 确保目录存在 (Node.js 脚本需要这些目录)
mkdir -p "$ARCHIVE_DIR"
mkdir -p "$TEMP_DIR"

echo "[$(date '+%Y-%m-%d %H:%M:%S')] 开始抓取 jable.tv 热榜..."

# 核心：运行 Node.js 脚本，传递所有路径
# 现在 node 会查找 /home/typecho/tools/jwksm/temp/jwksm.js
node "$TOOL_DIR/jwksm.js" "https://jable.tv/hot/" "$TEMP_DIR" "$ARCHIVE_DIR"

# 检查 Node.js 脚本的退出状态码
if [ $? -eq 0 ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 成功！数据处理和归档完成。"
    cp /home/typecho/tools/jwksm/daily/daily.json /home/typecho/tools/jwksm/temp/
    cd /home/typecho/tools/jwksm/time
    # 生成时间 json
    node generate.js
    cd /home/typecho/tools/jwksm/temp/
    node scrapeData.js
    ## 获取原始 ori.json
    cp /home/typecho/tools/jwksm/temp/ori.json /home/typecho/tools/jwksm/ori.json 
else
    # Node.js 脚本会打印详细的错误信息
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] 失败！请查看上方的 Node.js 错误信息。"
fi