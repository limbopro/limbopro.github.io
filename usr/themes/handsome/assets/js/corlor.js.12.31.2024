    function now(x) {
        var now = new Date();
        var convert = parseInt((now - x) / 1000);
        var getMinutes = parseInt(convert / 60);
        var getSeconds = convert % 60;
        var currentTime = "已在本页面停留" + getMinutes + "分钟" + getSeconds + "秒"
        return currentTime;
    }

