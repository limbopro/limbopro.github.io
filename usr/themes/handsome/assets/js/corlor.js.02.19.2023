    //// 灰度自动变化开始
    function remainder_change() { // remainder_change() 开始
        var day = new Date();
        var timezone = 30;
        var remainder = day.getMinutes() % timezone;
        var minutes = day.getMinutes();

        if (minutes < 30) {
            var values = (100 / timezone) * remainder
        } // 变暗
        else {
            var values = (100 / timezone) * (timezone - remainder)
        } // 变亮

        var style_innerHTML = document.querySelectorAll("style")
        for (i = 0; i < style_innerHTML.length; i++) {
            if (style_innerHTML[i].innerHTML.search("grayscale") >= 0) {
                var grayscale_x = 1;
                style_innerHTML[i].innerHTML = "img.fancybox-image,img.block,iframe,img,.item-thumb-small.lazy,.inner-image.bg,.gsc-search-button,.reaction-item__image {filter: grayscale(" + values + "%) !important;"
            } else {
                var grayscale_y = 0;
            }
        }

        if (typeof grayscale_x == "undefined") {
            var grayscale_x = 0;
        }

        var new_grayscale = grayscale_x + grayscale_y;
        if (new_grayscale === 0) {
            var style = "img.fancybox-image,img.block,iframe,img,.item-thumb-small.lazy,.inner-image.bg,.gsc-search-button,.reaction-item__image {filter: grayscale(" + values + "%) !important;";
            var creatcss = document.createElement("style");
            creatcss.innerHTML = style;
            document.getElementsByTagName('head')[0].appendChild(creatcss)
        }
    } // remainder_change() 结束
    //// 灰度自动变化结束

