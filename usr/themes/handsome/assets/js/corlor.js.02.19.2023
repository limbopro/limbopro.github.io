    function nsfw() { // 计算 nsfwCategory 的值
        var Color_Model = getCookie("Color_Model");
        if (Color_Model === "True" && count > 0) {
            css_add()
            //css_remove('hands');
        } else if (Color_Model === "Fasle") { css_remove("auto") } else {

